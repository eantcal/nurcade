/////////////////////////////////////////////////////////////////////////////
// Italian (Italy) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ITA)
LANGUAGE LANG_ITALIAN, SUBLANG_ITALIAN
#pragma code_page(1252)

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_WINRAYCAST          ICON                    "WinRayCast.ICO"

IDI_SMALL               ICON                    "SMALL.ICO"


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_WINRAYCAST MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open Project...",            ID_FILE_OPEN_PROJECT
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDM_EXIT
        MENUITEM SEPARATOR
        MENUITEM "&Information",                ID_FILE_INFO
        MENUITEM SEPARATOR
        MENUITEM "&About",                      ID_FILE_ABOUT
    END
    POPUP "&Audio"
    BEGIN
        MENUITEM "&Background music\tF9",       ID_AUDIO_BACKGROUND_MUSIC, CHECKED
        MENUITEM "Sound &effects\tF8",          ID_AUDIO_SOUND_EFFECTS, CHECKED
        MENUITEM "Read &all event messages",    ID_AUDIO_EVENT_SPEECH
        MENUITEM SEPARATOR
        MENUITEM "Volume &down\tF10",           ID_AUDIO_VOLUME_DOWN
        MENUITEM "Volume &up\tF11",             ID_AUDIO_VOLUME_UP
        MENUITEM "&Reset volume",               ID_AUDIO_VOLUME_RESET
    END
    POPUP "&View"
    BEGIN
        POPUP "&Projection window"
        BEGIN
            MENUITEM "&75%",                     ID_VIEW_PROJECTION_75
            MENUITEM "&90%",                     ID_VIEW_PROJECTION_90
            MENUITEM "&100%",                    ID_VIEW_PROJECTION_100
            MENUITEM "1&25%",                    ID_VIEW_PROJECTION_125
            MENUITEM "1&50%",                    ID_VIEW_PROJECTION_150
            MENUITEM "&200%",                    ID_VIEW_PROJECTION_200
            MENUITEM SEPARATOR
            MENUITEM "&Fit to screen",           ID_VIEW_PROJECTION_FIT_SCREEN
        END
    END
    POPUP "&Game"
    BEGIN
        MENUITEM "&Immortal player\tF7",        ID_GAME_IMMORTAL
        MENUITEM SEPARATOR
        MENUITEM "Enable all &keys",            ID_GAME_GIVE_ALL_KEYS
        MENUITEM "Enable all &weapons",         ID_GAME_GIVE_ALL_WEAPONS
        MENUITEM "Refill &ammo",                ID_GAME_REFILL_AMMO
        MENUITEM "Refill &energy",              ID_GAME_REFILL_ENERGY
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_WINRAYCAST ACCELERATORS
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 22, 17, 360, 190
STYLE DS_SETFONT | DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "About..."
FONT 8, "System", 0, 0, 0x0
BEGIN
    LTEXT           "WinRayCast Player",IDC_STATIC,10,7,76,8
    EDITTEXT        IDC_ABOUT_TEXT,10,20,340,145,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    DEFPUSHBUTTON   "OK",IDOK,305,170,45,14
END


