                                        <Button Content="Clear floor/ceiling" MinWidth="126"
                                                Command="{Binding ClearSelectedCellSurfacesCommand}" />
                                    </StackPanel>
                                </Grid>
                                <GroupBox Header="{Binding SelectedCellDoorSummary}"
