                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Max health" />
                            <TextBox Grid.Row="0" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding MaxHealth, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="1" Text="Current health" />
                            <TextBox Grid.Row="1" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding Health, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="2" Text="Attack damage" />
                            <TextBox Grid.Row="2" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding AttackDamage, UpdateSourceTrigger=LostFocus}" />
                            <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="Ranged attack"
                                      IsChecked="{Binding RangedAttack}"
                                      Margin="0,6,0,0" />
                            <TextBlock Grid.Row="4" Text="Attack range" />
                            <TextBox Grid.Row="4" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding AttackRangeCells, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="5" Text="Cooldown" />
                            <TextBox Grid.Row="5" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding AttackCooldownSeconds, UpdateSourceTrigger=LostFocus}" />
