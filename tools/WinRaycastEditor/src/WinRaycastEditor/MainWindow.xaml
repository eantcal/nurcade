                                    <TextBox Grid.Row="3" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding ExplosionScaleCells, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="4" Text="Explosion set" />
                                    <TextBox Grid.Row="4" Grid.Column="1"
                                             Text="{Binding ExplosionSpriteSet, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="5" Text="Destroyed set" />
                                    <TextBox Grid.Row="5" Grid.Column="1"
                                             Text="{Binding DestroyedSpriteSet, UpdateSourceTrigger=LostFocus}" />
                                     <TextBlock Grid.Row="6" Text="Destroyed scale" />
                                     <TextBox Grid.Row="6" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                              Text="{Binding DestroyedScaleCells, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="7" Text="Response type" Margin="0,8,0,0" />
                                    <TextBox Grid.Row="7" Grid.Column="1" Margin="0,8,0,0"
                                             Text="{Binding DamageResponseType, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="8" Text="Response HP" />
                                    <TextBox Grid.Row="8" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding DamageResponseHitPoints, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="9" Text="Effect set" />
                                    <TextBox Grid.Row="9" Grid.Column="1"
                                             Text="{Binding DamageEffectSpriteSet, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="10" Text="Effect animation" />
                                    <TextBox Grid.Row="10" Grid.Column="1"
                                             Text="{Binding DamageEffectAnimation, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="11" Text="Effect scale" />
                                    <TextBox Grid.Row="11" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding DamageEffectScaleCells, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="12" Text="Final set" />
                                    <TextBox Grid.Row="12" Grid.Column="1"
                                             Text="{Binding DamageDestroyedSpriteSet, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="13" Text="Final scale" />
                                    <TextBox Grid.Row="13" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding DamageDestroyedScaleCells, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="14" Text="Sound" />
                                    <TextBox Grid.Row="14" Grid.Column="1"
                                             Text="{Binding DamageSound, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="15" Text="Radius/damage" />
                                    <StackPanel Grid.Row="15" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="72" HorizontalAlignment="Left"
                                                 Text="{Binding DamageRadiusCells, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox Width="72" Margin="6,0,0,0" HorizontalAlignment="Left"
                                                 Text="{Binding DamageAmount, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                 </Grid>
                            </StackPanel>
                        </Border>
                        <StackPanel Visibility="{Binding IsItem, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Separator Margin="0,12,0,8" />
                        <TextBlock FontWeight="SemiBold" Text="Behavior" Margin="0,0,0,6" />
                        <StackPanel Orientation="Vertical">
                            <CheckBox Content="Chase player in detection radius"
                                      IsChecked="{Binding ChasePlayer}" />
                            <CheckBox Content="Patrol circuit inside home radius"
                                      IsChecked="{Binding PatrolCircuit}"
                                      Margin="0,4,0,0" />
                        </StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Speed" />
                            <TextBox Grid.Row="0" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding SpeedCellsPerSecond, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="1" Text="Detection radius" />
                            <TextBox Grid.Row="1" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding DetectionRadiusCells, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="2" Text="Patrol radius" />
                            <TextBox Grid.Row="2" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding PatrolRadiusCells, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="3" Text="Hysteresis" />
                            <TextBox Grid.Row="3" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding EngagementHysteresisCells, UpdateSourceTrigger=LostFocus}" />
