<Window x:Class="WinRaycastEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinRaycastEditor"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="720" Width="1180"
        Icon="Assets/AppIcon.ico"
        MinHeight="560" MinWidth="900"
        Closing="Window_Closing">
    <Window.InputBindings>
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCellCommand}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCellCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CopySpriteCommand}" />
        <KeyBinding Key="X" Modifiers="Control+Shift" Command="{Binding CutSpriteCommand}" />
        <KeyBinding Key="V" Modifiers="Control+Shift" Command="{Binding PasteSpriteCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <local:MapGridSizeConverter x:Key="MapGridSizeConverter" />
        <local:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter" />
        <local:SpriteMapMarkerSizeConverter x:Key="SpriteMapMarkerSizeConverter" />
        <local:SpriteMapMarkerOffsetConverter x:Key="SpriteMapMarkerOffsetConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <DataTemplate x:Key="TextureChoiceTemplate" DataType="{x:Type local:TextureChoiceViewModel}">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Preview}" Width="22" Height="22" Stretch="UniformToFill" Margin="0,0,6,0" />
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="BlockPaletteEntryTemplate" DataType="{x:Type local:BlockPaletteEntryViewModel}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Image Source="{Binding PrimaryPreview}" Width="22" Height="22" Margin="0,0,6,0"
                       VerticalAlignment="Center" Stretch="UniformToFill"
                       Visibility="{Binding HasPrimaryPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock>
                        <Run FontWeight="SemiBold" Text="{Binding Id, Mode=OneWay}" />
                        <Run Text=" - " />
                        <Run Text="{Binding Name, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="10" Foreground="#555" Text="{Binding Summary}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Background="#f4f4f4">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open world JSON..." Command="{Binding OpenWorldJsonCommand}" />
                <MenuItem Header="Open _project JSON..." Command="{Binding OpenProjectCommand}" />
                <Separator />
                <MenuItem Header="_Save all open JSON files" Command="{Binding SaveAllOpenJsonFilesCommand}"
                          ToolTip="Writes the open world, project, sprite set, and weapon JSON files back to their current paths." />
                <MenuItem Header="Save selected JSON _as"
                          ToolTip="Saves only the chosen JSON document to a selected path. Other open JSON files are unchanged.">
                    <MenuItem Header="_World JSON..." Command="{Binding SaveWorldJsonAsCommand}" />
                    <MenuItem Header="_Project JSON..." Command="{Binding SaveProjectAsCommand}" />
                    <MenuItem Header="_Current sprite set JSON..." Command="{Binding SaveSpriteMetadataAsCommand}" />
                    <MenuItem Header="_Current weapon metadata JSON..." Command="{Binding SaveWeaponMetadataAsCommand}" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy cell" Command="{Binding CopyCellCommand}" InputGestureText="Ctrl+C" />
                <MenuItem Header="_Paste cell" Command="{Binding PasteCellCommand}" InputGestureText="Ctrl+V" />
                <Separator />
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="Edit selected cell _unique block" Command="{Binding EditSelectedCellUniqueBlockCommand}" />
                <MenuItem Header="_Make selected cell unique block" Command="{Binding MakeSelectedCellUniqueBlockCommand}" />
                <MenuItem Header="_Edit selected cell shared block" Command="{Binding OpenSelectedCellBlockCommand}" />
                <MenuItem Header="_Clone selected shared block" Command="{Binding CloneSelectedBlockCommand}" />
                <MenuItem Header="_Apply texture to selected cell" Command="{Binding PaintSelectedCellCommand}" />
                <Separator />
                <MenuItem Header="Edit as _JSON"
                          IsCheckable="True"
                          IsChecked="{Binding JsonPanel.IsVisible}"
                          ToolTip="Show the dockable JSON editor panel for direct, validated editing of the world or selected sprite." />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom _in" Command="{Binding ZoomInCommand}" />
                <MenuItem Header="Zoom _out" Command="{Binding ZoomOutCommand}" />
                <MenuItem Header="_Reset zoom" Command="{Binding ResetZoomCommand}" />
            </MenuItem>
            <MenuItem Header="_Sprites">
                <MenuItem Header="_Open sprite set..." Command="{Binding OpenSpriteMetadataCommand}" />
                <MenuItem Header="_Save sprite set as..." Command="{Binding SaveSpriteMetadataAsCommand}" />
                <Separator />
                <MenuItem Header="_Add sprite to selected cell" Command="{Binding AddSpriteToSelectedCellCommand}" />
                <MenuItem Header="Add _item to selected cell" Command="{Binding AddItemToSelectedCellCommand}" />
                <MenuItem Header="_Remove selected sprite" Command="{Binding RemoveSelectedSpriteCommand}" />
                <Separator />
                <MenuItem Header="_Copy selected sprite" Command="{Binding CopySpriteCommand}" InputGestureText="Ctrl+Shift+C" />
                <MenuItem Header="Cu_t selected sprite" Command="{Binding CutSpriteCommand}" InputGestureText="Ctrl+Shift+X" />
                <MenuItem Header="_Paste sprite to selected cell" Command="{Binding PasteSpriteCommand}" InputGestureText="Ctrl+Shift+V" />
            </MenuItem>
            <MenuItem Header="_Weapon">
                <MenuItem Header="_Open current weapon JSON" Command="{Binding OpenWeaponJsonCommand}" />
                <MenuItem Header="_Refresh weapon library" Command="{Binding RefreshWeaponLibraryCommand}" />
                <MenuItem Header="_Use selected weapon as player weapon" Command="{Binding UseSelectedWeaponAsPlayerCommand}" />
                <MenuItem Header="_Clone current weapon metadata..." Command="{Binding CloneWeaponMetadataCommand}" />
                <MenuItem Header="_Remove player weapon reference" Command="{Binding RemovePlayerWeaponCommand}" />
                <Separator />
                <MenuItem Header="_Reload weapon metadata" Command="{Binding ReloadWeaponMetadataCommand}" />
                <MenuItem Header="_Save weapon metadata" Command="{Binding SaveWeaponMetadataCommand}" />
                <MenuItem Header="Save weapon metadata _as..." Command="{Binding SaveWeaponMetadataAsCommand}" />
            </MenuItem>
            <MenuItem Header="_World">
                <MenuItem Header="_Validate" Command="{Binding ValidateCommand}" />
                <MenuItem Header="_Clone active layer" Command="{Binding CloneSelectedWorldLayerCommand}" />
                <MenuItem Header="Change active layer _ID..." Command="{Binding RenameSelectedWorldLayerCommand}" />
                <MenuItem Header="_Delete active layer..." Command="{Binding DeleteSelectedWorldLayerCommand}" />
                <MenuItem Header="_Export playable demo package..." Command="{Binding ExportCommand}" />
                <MenuItem Header="_Test in 3D" Command="{Binding TestIn3DCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About WinRaycast Editor" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="#20242b" Padding="12">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Foreground="White" FontSize="18" FontWeight="SemiBold"
                           Text="WinRaycastEditor" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Left"
                        Content="Run Game"
                        Command="{Binding TestIn3DCommand}"
                        Margin="18,0,0,0"
                        Padding="18,8"
                        MinWidth="118"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#2f8f46"
                        BorderBrush="#1f6f34"
                        ToolTip="Export the current world to a temporary preview and run it in WinRayCastPlayer." />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Foreground="#cfd3da" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               Text="Layer ID:" />
                    <ComboBox MinWidth="160"
                              ItemsSource="{Binding WorldLayers}"
                              SelectedItem="{Binding SelectedWorldLayer}"
                              DisplayMemberPath="Id"
                              IsEnabled="{Binding HasMultipleWorldLayers}"
                              ToolTip="Switch the active world layer (level_1, level_2, ...)" />
                    <TextBlock Foreground="#cfd3da" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,6,0"
                               Text="Display name:" />
                    <TextBox Width="140" VerticalContentAlignment="Center"
                             Text="{Binding SelectedWorldLayerDisplayName, UpdateSourceTrigger=LostFocus}"
                             ToolTip="Name shown to players in elevator destination lists." />
                    <TextBlock Foreground="#cfd3da" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,6,0"
                               Text="Brightness:" />
                    <TextBox Width="58" VerticalContentAlignment="Center"
                             Text="{Binding SelectedWorldLayer.Brightness, UpdateSourceTrigger=LostFocus}"
                             ToolTip="Area brightness multiplier: 1.0 is neutral, lower is darker." />
                    <TextBlock Foreground="#cfd3da" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,6,0"
                               Text="Depth shading:" />
                    <TextBox Width="58" VerticalContentAlignment="Center"
                             Text="{Binding SelectedWorldLayer.DepthShading, UpdateSourceTrigger=LostFocus}"
                             ToolTip="Distance shading strength: larger values darken nearby surfaces sooner; 100 is the legacy value." />
                    <Button Content="Clone"
                            MinWidth="56"
                            Margin="8,0,0,0"
                            Command="{Binding CloneSelectedWorldLayerCommand}" />
                    <Button Content="Rename ID"
                            MinWidth="64"
                            Margin="6,0,0,0"
                            Command="{Binding RenameSelectedWorldLayerCommand}" />
                    <Button Content="Delete"
                            MinWidth="58"
                            Margin="6,0,0,0"
                            Command="{Binding DeleteSelectedWorldLayerCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{Binding JsonPanel.IsVisible, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=5}" />
                <ColumnDefinition Width="{Binding JsonPanel.IsVisible, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter=480}"
                                  MinWidth="0" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#d0d0d0" BorderThickness="1" Padding="8">
                <TabControl TabStripPlacement="Left"
                            SelectedIndex="{Binding SelectedInspectorTabIndex}">
                    <TabItem Header="Map">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4">
                    <TextBlock FontWeight="SemiBold" FontSize="15" Text="Project" />
                    <TextBlock Margin="0,12,0,0" Text="{Binding MapSummary}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding MapSelectionSummary}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding TextureSummary}" />
                    <TextBlock Margin="0,4,0,12" Text="{Binding SpriteSummary}" />
                    <TextBlock Margin="0,0,0,12" Text="{Binding SpriteMetadataSummary}" TextWrapping="Wrap" />
                    <Separator />
                    <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="World Background" />
                    <TextBlock Margin="0,0,0,6" FontSize="10" Foreground="#555"
                               Text="{Binding WorldBackgroundSummary}" TextWrapping="Wrap" />
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                            <Button Content="Browse" MinWidth="64" Command="{Binding BrowseWorldBackgroundCommand}" />
                            <Button Content="Clear" MinWidth="54" Margin="4,0,0,0" Command="{Binding ClearWorldBackgroundCommand}" />
                        </StackPanel>
                        <TextBox Text="{Binding WorldBackgroundImage, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Margin="0,8,0,4" FontWeight="SemiBold" Text="Level Music" />
                    <TextBlock Margin="0,0,0,6" FontSize="10" Foreground="#555"
                               Text="{Binding LevelBackgroundMusicSummary}" TextWrapping="Wrap" />
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                            <Button Content="Browse" MinWidth="64" Command="{Binding BrowseLevelBackgroundMusicCommand}" />
                            <Button Content="Clear" MinWidth="54" Margin="4,0,0,0" Command="{Binding ClearLevelBackgroundMusicCommand}" />
                        </StackPanel>
                        <TextBox Text="{Binding LevelBackgroundMusicFile, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox Content="Enabled"
                                  IsChecked="{Binding LevelBackgroundMusicEnabled}"
                                  Margin="0,0,12,0" />
                        <CheckBox Content="Loop"
                                  IsChecked="{Binding LevelBackgroundMusicLoop}" />
                    </StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left"
                                   Width="48"
                                   VerticalAlignment="Center"
                                   Text="Volume" />
                        <TextBlock DockPanel.Dock="Right"
                                   Width="42"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Text="{Binding LevelBackgroundMusicVolumeLabel}" />
                        <Slider Minimum="0"
                                Maximum="100"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                Value="{Binding LevelBackgroundMusicVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <Separator />
                    <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="Player Turn" />
                    <TextBlock Margin="0,0,0,6" FontSize="10" Foreground="#555" TextWrapping="Wrap"
                               Text="Rotation feel (degrees/second). The turn rate ramps from the base up to the cap; higher acceleration makes it snappier." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="78" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Base °/s" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2"
                                 ToolTip="Initial turn rate while tapping the arrow keys (precise small turns)."
                                 Text="{Binding PlayerTurnBaseDegreesPerSecond, UpdateSourceTrigger=PropertyChanged, StringFormat=0.#}" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Cap °/s" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2"
                                 ToolTip="Maximum turn rate reached after holding the key."
                                 Text="{Binding PlayerTurnMaxDegreesPerSecond, UpdateSourceTrigger=PropertyChanged, StringFormat=0.#}" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Accel °/s²" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2"
                                 ToolTip="How quickly the turn rate ramps from base to cap."
                                 Text="{Binding PlayerTurnAccelerationDegreesPerSecondSquared, UpdateSourceTrigger=PropertyChanged, StringFormat=0.#}" />
                    </Grid>
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGoalLayerSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Separator Margin="0,0,0,8" />
                        <TextBlock FontWeight="SemiBold" Text="Game Goal" />
                        <TextBlock Margin="0,4,0,8"
                                   FontSize="10"
                                   Foreground="#667085"
                                   Text="The game ends when the player enters the configured cell."
                                   TextWrapping="Wrap" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding GameGoalSummary}" />
                        <TextBlock Margin="0,8,0,2" Text="Required key (optional)" />
                        <TextBox Text="{Binding GameGoalRequiredKey, UpdateSourceTrigger=LostFocus}"
                                 IsEnabled="{Binding HasGameGoal}"
                                 ToolTip="Leave empty when entering the final cell does not require a key." />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Set selected cell"
                                    MinWidth="116"
                                    Margin="0,0,6,0"
                                    Command="{Binding SetSelectedCellAsGameGoalCommand}" />
                            <Button Content="Clear goal"
                                    MinWidth="76"
                                    Command="{Binding ClearGameGoalCommand}" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCellEditingLayerSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Separator Margin="0,0,0,8" />
                        <TextBlock FontWeight="SemiBold" Text="Cell Editing" />
                        <TextBlock Margin="0,4,0,8"
                                   FontSize="10"
                                   Foreground="#667085"
                                   Text="{Binding SelectedCellInstanceSummary}"
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Apply edits to"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding CellEditScopes}"
                                      SelectedItem="{Binding SelectedCellEditScope}"
                                      ToolTip="Selected cell creates/updates a private block for this cell. Shared template updates every cell using this block." />
                        </Grid>
                        <Grid Margin="0,6,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Cell" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCell.Coordinates}" />
                            <TextBlock Grid.Row="1" Text="Block" />
                            <DockPanel Grid.Row="1" Grid.Column="1">
                                <Button DockPanel.Dock="Right"
                                        Content="Open"
                                        MinWidth="56"
                                        Margin="6,0,0,0"
                                        Command="{Binding OpenSelectedCellBlockCommand}" />
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding SelectedCellBlockSummary}" />
                            </DockPanel>
                            <TextBlock Grid.Row="2" Text="Refs" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding SelectedCellBlockReferenceCount}" />
                        </Grid>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="Edit unique"
                                    MinWidth="92"
                                    Margin="0,0,6,6"
                                    Command="{Binding EditSelectedCellUniqueBlockCommand}"
                                    ToolTip="Create or reuse a private block for this cell, then open it in the Block tab." />
                            <Button Content="Edit shared block"
                                    MinWidth="118"
                                    Margin="0,0,6,6"
                                    Command="{Binding OpenSelectedCellBlockCommand}"
                                    ToolTip="Open the block template. Edits there affect every cell using this block id." />
                        </WrapPanel>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWallLayerSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Wall Textures" />
                            <TextBlock Text="Lower wall" />
                            <ComboBox ItemsSource="{Binding TextureChoices}"
                                      ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding SelectedCellLowerWallTextureKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,6,0,0" Text="Upper wall" />
                            <ComboBox ItemsSource="{Binding TextureChoices}"
                                      ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding SelectedCellUpperWallTextureKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,6,0,0" Text="Transparent wall" />
                            <ComboBox ItemsSource="{Binding TextureChoices}"
                                      ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding SelectedCellTransparentWallTextureKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFloorLayerSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Floor Texture" />
                            <ComboBox ItemsSource="{Binding TextureChoices}"
                                      ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding SelectedCellFloorTextureKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCeilingLayerSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Ceiling Texture" />
                            <ComboBox ItemsSource="{Binding TextureChoices}"
                                      ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding SelectedCellCeilingTextureKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,4" FontWeight="SemiBold" Text="Template Palette (advanced)" />
                        <TextBlock Margin="0,0,0,6"
                                   FontSize="10"
                                   Foreground="#667085"
                                   Text="Normally edit through the selected cell above. This palette is only for selecting/cloning shared templates directly."
                                   TextWrapping="Wrap" />
                        <ListBox ItemsSource="{Binding Blocks}"
                                 SelectedItem="{Binding SelectedBlock}"
                                 MaxHeight="92">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Image Source="{Binding PrimaryPreview}"
                                               Width="22"
                                               Height="22"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding HasPrimaryPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <StackPanel>
                                            <TextBlock>
                                                <Run FontWeight="SemiBold" Text="{Binding Id, Mode=OneWay}" />
                                                <Run Text=" - " />
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock FontSize="10" Foreground="#555" Text="{Binding Summary}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Margin="0,6,0,0"
                                Height="120"
                                Background="#202428"
                                BorderBrush="#808894"
                                BorderThickness="1"
                                Visibility="{Binding SelectedBlock.HasPrimaryPreview, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                            <Grid>
                                <Image Source="{Binding SelectedBlock.PrimaryPreview}"
                                       Stretch="Uniform"
                                       Margin="4" />
                                <Border VerticalAlignment="Bottom"
                                        Background="#cc000000"
                                        Padding="6,3">
                                    <TextBlock Foreground="White" FontSize="11">
                                        <Run FontWeight="SemiBold" Text="{Binding SelectedBlock.Id, Mode=OneWay}" />
                                        <Run Text=" - " />
                                        <Run Text="{Binding SelectedBlock.Name, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>
                        <Button Margin="0,6,0,0"
                                Content="Clone selected template"
                                Command="{Binding CloneSelectedBlockCommand}" />
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedLayer}" Value="Sprites">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Separator Margin="0,0,0,8" />
                        <TextBlock FontWeight="SemiBold" Text="Sprite Editing" />
                        <Grid Margin="0,4,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Rename"
                                       VerticalAlignment="Center"
                                       FontSize="10" />
                            <TextBox Grid.Column="1"
                                     ToolTip="Rename the selected sprite actor"
                                     Text="{Binding SelectedSprite.Name, UpdateSourceTrigger=LostFocus, TargetNullValue=No sprite selected, FallbackValue=No sprite selected}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="IsEnabled" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSprite}" Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                        <Border Height="132"
                                Background="#20242b"
                                BorderBrush="#808894"
                                BorderThickness="1"
                                Margin="0,0,0,8">
                            <Canvas ClipToBounds="True">
                                <Image Source="{Binding SelectedSpritePreview}"
                                       Width="82"
                                       Height="82"
                                       Stretch="Uniform"
                                       Canvas.Left="10"
                                       Canvas.Top="10" />
                                <TextBlock Text="{Binding SelectedSprite.Name, TargetNullValue=No sprite selected}"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           Canvas.Left="104"
                                           Canvas.Top="12" />
                                <TextBlock Text="{Binding SpriteClipboardSummary}"
                                           Foreground="#d9e5f2"
                                           FontSize="11"
                                           Canvas.Left="104"
                                           Canvas.Top="34" />
                                <Button Content="Cancel pending"
                                        Command="{Binding CancelSpriteClipboardCommand}"
                                        MinWidth="112"
                                        Canvas.Left="104"
                                        Canvas.Top="64" />
                                <Button Content="Delete"
                                        Command="{Binding RemoveSelectedSpriteCommand}"
                                        MinWidth="78"
                                        Canvas.Left="224"
                                        Canvas.Top="64" />
                            </Canvas>
                        </Border>
                        <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Keys in this level" />
                        <ListBox ItemsSource="{Binding KeySprites}"
                                 SelectedItem="{Binding SelectedSprite}"
                                 MaxHeight="86"
                                 Margin="0,0,0,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <ComboBox DockPanel.Dock="Right"
                                                  Width="72"
                                                  ItemsSource="{Binding KeyColorOptions}"
                                                  SelectedItem="{Binding KeyColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock VerticalAlignment="Center">
                                            <Run FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" />
                                            <Run Text="  (" />
                                            <Run Text="{Binding Position, Mode=OneWay}" />
                                            <Run Text=")" />
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Cell sprites" />
                        <ListBox ItemsSource="{Binding SelectedCellSprites}"
                                 SelectedItem="{Binding SelectedSprite}"
                                 MaxHeight="96"
                                 Margin="0,0,0,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock FontSize="10" Text="{Binding SpriteSet}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock FontSize="10" Text="{Binding CategoryLabel}" HorizontalAlignment="Right" />
                                            <TextBlock FontSize="10" Text="{Binding Position}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel DataContext="{Binding SelectedSprite}" Margin="0,0,0,8">
                            <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Selected Sprite Properties" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="X cell" />
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Width="82"
                                         HorizontalAlignment="Left"
                                         Text="{Binding XCell, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Grid.Row="1" Text="Y cell" />
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Width="82"
                                         HorizontalAlignment="Left"
                                         Text="{Binding YCell, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Grid.Row="2" Text="Facing" />
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Width="82"
                                         HorizontalAlignment="Left"
                                         Text="{Binding FacingDegrees, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Grid.Row="3" Text="Scale" />
                                <TextBox Grid.Row="3" Grid.Column="1"
                                         Width="82"
                                         HorizontalAlignment="Left"
                                         Text="{Binding ScaleCells, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Grid.Row="4" Text="Speed"
                                           Visibility="{Binding IsItem, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         Width="82"
                                         HorizontalAlignment="Left"
                                         Visibility="{Binding IsItem, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                         Text="{Binding SpeedCellsPerSecond, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Grid.Row="5" Text="Detect"
                                           Visibility="{Binding IsItem, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <TextBox Grid.Row="5" Grid.Column="1"
                                         Width="82"
                                         HorizontalAlignment="Left"
                                         Visibility="{Binding IsItem, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                         Text="{Binding DetectionRadiusCells, UpdateSourceTrigger=LostFocus}" />
                                <WrapPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                    <CheckBox Content="Visible"
                                              IsChecked="{Binding Visible}"
                                              Margin="0,0,10,4" />
                                    <CheckBox Content="Pass-through"
                                              IsChecked="{Binding PassThroughWalls}"
                                              Margin="0,0,10,4" />
                                    <CheckBox Content="Save point"
                                              IsChecked="{Binding SavePoint}"
                                              Visibility="{Binding IsItem, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              Margin="0,0,10,4" />
                                    <CheckBox Content="Patrol"
                                              IsChecked="{Binding PatrolCircuit}"
                                              Visibility="{Binding IsItem, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                              Margin="0,0,10,4" />
                                    <CheckBox Content="Chase"
                                              IsChecked="{Binding ChasePlayer}"
                                              Visibility="{Binding IsItem, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                              Margin="0,0,10,4" />
                                </WrapPanel>
                            </Grid>
                        </StackPanel>
                        <WrapPanel>
                            <Button Content="Add enemy"
                                    Command="{Binding AddSpriteToSelectedCellCommand}"
                                    ToolTip="Place the selected sprite set as an enemy/monster (uses item defaults automatically for item sprite sets)."
                                    MinWidth="58"
                                    Margin="0,0,6,6" />
                            <Button Content="Add item"
                                    Command="{Binding AddItemToSelectedCellCommand}"
                                    ToolTip="Place the selected sprite set as a static, pass-through item with no combat stats."
                                    MinWidth="58"
                                    Margin="0,0,6,6" />
                            <Button Content="Copy"
                                    Command="{Binding CopySpriteCommand}"
                                    MinWidth="58"
                                    Margin="0,0,6,6" />
                            <Button Content="Cut"
                                    Command="{Binding CutSpriteCommand}"
                                    MinWidth="58"
                                    Margin="0,0,6,6" />
                            <Button Content="Paste"
                                    Command="{Binding PasteSpriteCommand}"
                                    MinWidth="58"
                                    Margin="0,0,6,6" />
                        </WrapPanel>
                    </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Library">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4">
                    <TextBlock Margin="0,12,0,6" FontWeight="SemiBold" Text="Texture / Block Library" />
                    <Border AllowDrop="True"
                            Background="Transparent"
                            BorderBrush="#c4ccd6"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="4"
                            DragOver="TextureLibrary_DragOver"
                            Drop="TextureLibrary_Drop"
                            ToolTip="Drag PNG or BMP images here to add them to the texture library.">
                        <StackPanel>
                            <ListBox ItemsSource="{Binding Textures}"
                                     SelectedItem="{Binding SelectedTexture}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     MaxHeight="220">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" Background="#efefef" BorderBrush="#bbbbbb" BorderThickness="1">
                                                <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Key}" />
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock FontSize="10" Text="{Binding Status}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Margin="2,6,2,2"
                                       FontSize="10"
                                       Foreground="#667085"
                                       TextWrapping="Wrap"
                                       Text="Drag PNG/BMP images here to add textures, or use the button below." />
                            <Button Margin="0,6,0,0"
                                    HorizontalAlignment="Left"
                                    Padding="10,3"
                                    Content="Add texture…"
                                    Click="AddTexture_Click" />
                        </StackPanel>
                    </Border>
                    <Separator Margin="0,12,0,0" />
                    <TextBlock Margin="0,12,0,6" FontWeight="SemiBold" Text="Block Palette" />
                    <TextBlock Margin="0,0,0,6" FontSize="10" Text="{Binding BlockSummary}" />
                    <ListBox ItemsSource="{Binding Blocks}"
                             SelectedItem="{Binding SelectedBlock}"
                             MaxHeight="160">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Image Source="{Binding PrimaryPreview}"
                                           Width="22"
                                           Height="22"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"
                                           Stretch="UniformToFill"
                                           Visibility="{Binding HasPrimaryPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <StackPanel>
                                        <TextBlock>
                                            <Run FontWeight="SemiBold" Text="{Binding Id, Mode=OneWay}" />
                                            <Run Text=" — " />
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="10" Foreground="#555" Text="{Binding Summary}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Margin="0,6,0,0"
                            Height="140"
                            Background="#202428"
                            BorderBrush="#808894"
                            BorderThickness="1"
                            Visibility="{Binding SelectedBlock.HasPrimaryPreview, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <Grid>
                            <Image Source="{Binding SelectedBlock.PrimaryPreview}"
                                   Stretch="Uniform"
                                   Margin="4" />
                            <Border VerticalAlignment="Bottom"
                                    Background="#cc000000"
                                    Padding="6,3">
                                <TextBlock Foreground="White" FontSize="11">
                                    <Run FontWeight="SemiBold" Text="{Binding SelectedBlock.Id, Mode=OneWay}" />
                                    <Run Text=" - " />
                                    <Run Text="{Binding SelectedBlock.Name, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>
                    <Button Margin="0,6,0,0"
                            Content="Clone selected block"
                            Command="{Binding CloneSelectedBlockCommand}" />
                    <Button Margin="0,6,0,0"
                            Content="Remove duplicate blocks"
                            ToolTip="Merge palette blocks that look identical into one and repoint every cell to it."
                            Command="{Binding RemoveDuplicateBlocksCommand}" />
                    <Button Margin="0,6,0,0"
                            Content="Remove unused blocks"
                            ToolTip="Delete palette blocks that are not referenced by any cell, layer, or transition trigger."
                            Command="{Binding RemoveUnusedBlocksCommand}" />
                    <TextBlock Margin="0,10,0,4" FontWeight="SemiBold" Text="Paint Target" />
                    <ComboBox ItemsSource="{Binding PaintTargets}"
                              SelectedItem="{Binding SelectedPaintTarget}"
                              Margin="0,0,0,6" />
                    <CheckBox Content="Paint while selecting"
                              IsChecked="{Binding IsPaintModeEnabled}"
                              Margin="0,0,0,6" />
                    <Button Content="Apply texture to cell"
                            Command="{Binding PaintSelectedCellCommand}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Sprites">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4">
                    <TextBlock Margin="0,12,0,6" FontWeight="SemiBold" Text="Sprite Animations" />
                    <TextBlock Margin="0,0,0,6" FontSize="10" Text="{Binding SpriteTransparentColorSummary}" />
                    <ComboBox ItemsSource="{Binding SpriteSetFiles}"
                              SelectedItem="{Binding SelectedSpriteSetFile}"
                              Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding SpriteAnimations}"
                             SelectedItem="{Binding SelectedSpriteAnimation}"
                             MaxHeight="96">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" FontSize="10" Text="{Binding Summary}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="Add"
                                Command="{Binding AddSpriteAnimationCommand}"
                                MinWidth="58"
                                Margin="0,0,6,6" />
                        <Button Content="Duplicate"
                                Command="{Binding DuplicateSpriteAnimationCommand}"
                                MinWidth="78"
                                Margin="0,0,6,6" />
                        <Button Content="Remove"
                                Command="{Binding RemoveSpriteAnimationCommand}"
                                MinWidth="70"
                                Margin="0,0,6,6" />
                    </WrapPanel>
                    <Grid DataContext="{Binding SelectedSpriteAnimation}" Margin="0,6,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Frame ms" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Width="62"
                                 Text="{Binding FrameDurationMs, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Grid.Column="2"
                                  Content="Loop"
                                  IsChecked="{Binding Loop}"
                                  VerticalAlignment="Center"
                                  Margin="8,0,0,0" />
                    </Grid>
                    <ListBox ItemsSource="{Binding SpriteAnimationFrames}"
                             SelectedItem="{Binding SelectedSpriteAnimationFrame}"
                             MaxHeight="72"
                             Margin="0,0,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" FontSize="10" Text="{Binding Summary}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Add frame"
                                Command="{Binding AddSpriteAnimationFrameCommand}"
                                MinWidth="82"
                                Margin="0,0,6,6" />
                        <Button Content="Duplicate"
                                Command="{Binding DuplicateSpriteAnimationFrameCommand}"
                                MinWidth="78"
                                Margin="0,0,6,6" />
                        <Button Content="Remove"
                                Command="{Binding RemoveSpriteAnimationFrameCommand}"
                                MinWidth="70"
                                Margin="0,0,6,6" />
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,6" FontWeight="SemiBold" Text="Sprite Directions" />
                    <Border Height="230"
                            Background="#20242b"
                            BorderBrush="#808894"
                            BorderThickness="1"
                            Margin="0,0,0,6">
                        <Grid>
                            <Image Source="{Binding AnimationPlayback.CurrentPreview}"
                                   Stretch="Uniform"
                                   Margin="8">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AnimationPlayback.CurrentPreview}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <Image Source="{Binding SelectedSpriteDirectionPreview}"
                                   Stretch="Uniform"
                                   Margin="8">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AnimationPlayback.CurrentPreview}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <Border Background="#cc20242b"
                                    Padding="6,3"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right">
                                <TextBlock Foreground="White"
                                           FontSize="11"
                                           Text="{Binding AnimationPlayback.Summary}" />
                            </Border>
                            <Border Background="#cc20242b"
                                    Padding="6,3"
                                    VerticalAlignment="Bottom">
                                <TextBlock Foreground="White"
                                           FontSize="11"
                                           Text="{Binding SelectedSpriteDirectionSummary}" />
                            </Border>
                        </Grid>
                    </Border>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="|◀"
                                    ToolTip="Step backward one frame"
                                    Command="{Binding StepAnimationBackwardCommand}"
                                    MinWidth="36"
                                    Margin="0,0,4,0" />
                            <Button Content="▶"
                                    ToolTip="Play animation"
                                    Command="{Binding PlayAnimationCommand}"
                                    MinWidth="36"
                                    Margin="0,0,4,0" />
                            <Button Content="❚❚"
                                    ToolTip="Pause animation"
                                    Command="{Binding PauseAnimationCommand}"
                                    MinWidth="36"
                                    Margin="0,0,4,0" />
                            <Button Content="■"
                                    ToolTip="Stop and rewind to first frame"
                                    Command="{Binding StopAnimationCommand}"
                                    MinWidth="36"
                                    Margin="0,0,4,0" />
                            <Button Content="▶|"
                                    ToolTip="Step forward one frame"
                                    Command="{Binding StepAnimationForwardCommand}"
                                    MinWidth="36" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="#555"
                                   Text="{Binding AnimationPlayback.Summary}" />
                    </Grid>
                    <ListBox ItemsSource="{Binding SpriteDirections}"
                             SelectedItem="{Binding SelectedSpriteDirection}"
                             MaxHeight="190">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="54" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" Background="#20242b" BorderBrush="#bbbbbb" BorderThickness="1">
                                        <Image Source="{Binding Preview}" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock FontSize="10" Text="{Binding PreviewResolution}" />
                                        <TextBlock FontSize="10" Text="{Binding Resolutions}" />
                                        <TextBlock FontSize="10" Text="{Binding SelectedResolution}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Angle}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Margin="0,10,0,4" FontWeight="SemiBold" Text="Sprite LOD" />
                    <Slider Minimum="0.5" Maximum="20" TickFrequency="0.5"
                            IsSnapToTickEnabled="True"
                            Value="{Binding SpritePreviewDistance, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,2,0,4" Text="{Binding SpriteLodSelectionSummary}" />
                    <ListBox ItemsSource="{Binding SpriteLodRules}" MaxHeight="86">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding MaxDistance}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Resolution}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <UniformGrid Margin="0,8,0,0" Columns="2">
                        <Button Content="Add enemy to cell"
                                Command="{Binding AddSpriteToSelectedCellCommand}"
                                ToolTip="Place the selected sprite set as an enemy/monster (uses item defaults automatically for item sprite sets)."
                                Margin="0,0,3,0" />
                        <Button Content="Add item to cell"
                                Command="{Binding AddItemToSelectedCellCommand}"
                                ToolTip="Place the selected sprite set as a static, pass-through item with no combat stats."
                                Margin="3,0,0,0" />
                    </UniformGrid>
                    <TextBlock Margin="0,10,0,4" FontWeight="SemiBold" Text="Sprite Instances" />
                    <ListBox ItemsSource="{Binding SpriteInstances}"
                             SelectedItem="{Binding SelectedSprite}"
                             MaxHeight="96">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2"
                                      PreviewMouseLeftButtonDown="SpriteDrag_PreviewMouseLeftButtonDown"
                                      MouseMove="SpriteDrag_MouseMove">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="78" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock FontSize="10" Text="{Binding SpriteSet}" />
                                        <TextBlock FontSize="10" Text="{Binding MovementSummary}" />
                                        <TextBlock FontSize="10" Text="{Binding HealthSummary}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding CategoryLabel}" HorizontalAlignment="Right" />
                                        <TextBlock FontSize="10" Text="{Binding Position}" HorizontalAlignment="Right" />
                                        <TextBlock FontSize="10" Text="{Binding Facing}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Margin="0,6,0,0"
                            Content="Remove selected sprite"
                            Command="{Binding RemoveSelectedSpriteCommand}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Copy"
                                Command="{Binding CopySpriteCommand}"
                                MinWidth="64"
                                Margin="0,0,6,0" />
                        <Button Content="Cut"
                                Command="{Binding CutSpriteCommand}"
                                MinWidth="64"
                                Margin="0,0,6,0" />
                        <Button Content="Paste to cell"
                                Command="{Binding PasteSpriteCommand}"
                                MinWidth="92" />
                    </StackPanel>
                    <Separator Margin="0,12,0,8" />
                    <StackPanel DataContext="{Binding SelectedSprite}">
                        <TextBlock FontWeight="SemiBold" FontSize="15" Text="Selected Sprite" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Name" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="1" Text="Sprite set" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SpriteSet}" />
                            <TextBlock Grid.Row="2" Text="X cell" />
                            <TextBox Grid.Row="2" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding XCell, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="3" Text="Y cell" />
                            <TextBox Grid.Row="3" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding YCell, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="4" Text="Facing" />
                            <TextBox Grid.Row="4" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding FacingDegrees, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="5" Text="Scale" />
                            <TextBox Grid.Row="5" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding ScaleCells, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="6" Text="Collision radius" />
                            <TextBox Grid.Row="6" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding CollisionRadiusCells, UpdateSourceTrigger=LostFocus}" />
                            <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
