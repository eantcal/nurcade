                                             Text="{Binding ExplosionRadiusCells, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="2" Text="Damage" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding ExplosionDamage, UpdateSourceTrigger=LostFocus}" />
