                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Green" />
                                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,3"
                                                      ItemsSource="{Binding TextureChoices}"
                                                      ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                                      SelectedValuePath="Key"
                                                      SelectedValue="{Binding SelectedCellDoorGreenOverlayTexture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Row="1" Text="Blue" />
                                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,3"
                                                      ItemsSource="{Binding TextureChoices}"
                                                      ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                                      SelectedValuePath="Key"
                                                      SelectedValue="{Binding SelectedCellDoorBlueOverlayTexture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Row="2" Text="Red" />
                                            <ComboBox Grid.Row="2" Grid.Column="1"
                                                      ItemsSource="{Binding TextureChoices}"
                                                      ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                                      SelectedValuePath="Key"
                                                      SelectedValue="{Binding SelectedCellDoorRedOverlayTexture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <TextBlock Grid.Row="6" Text="Frames" />
                                        <TextBlock Grid.Row="6"
                                                   Grid.Column="1"
                                                   Foreground="#555"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding SelectedCellDoorFramesText}" />
                                    </Grid>
                                </GroupBox>
                                <GroupBox Header="Connected floors"
                                          Margin="0,10,0,0"
                                          Padding="8"
                                          Visibility="{Binding SelectedCellIsElevator, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,6"
                                                   Foreground="#555"
                                                   TextWrapping="Wrap"
                                                   Text="Select every floor reachable from this elevator." />
                                        <ItemsControl ItemsSource="{Binding SelectedCellLayerConnections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Label}"
                                                              IsChecked="{Binding IsConnected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </GroupBox>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Edit unique block"
                                            MinWidth="128"
                                            Margin="0,0,6,6"
                                            Command="{Binding EditSelectedCellUniqueBlockCommand}" />
                                    <Button Content="Edit shared block"
                                            MinWidth="118"
                                            Margin="0,0,6,6"
                                            Command="{Binding OpenSelectedCellBlockCommand}" />
                                    <Button Content="Make unique"
                                            MinWidth="96"
                                            Margin="0,0,6,6"
                                            Command="{Binding MakeSelectedCellUniqueBlockCommand}"
                                            ToolTip="Create a private block copy for this selected cell without switching tabs." />
                                </WrapPanel>
                                <Border Margin="0,12,0,0"
                                        Background="#2c3a4a"
                                        Padding="10"
                                        Visibility="{Binding HasSelectedCellFace, Converter={StaticResource BooleanToVisibilityConverter}}">
