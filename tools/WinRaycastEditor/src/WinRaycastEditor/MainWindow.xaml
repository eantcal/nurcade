                            <TextBox Grid.Row="8" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding AttackBurstPauseSeconds, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                        </StackPanel>
                    </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Cell">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4">
                                <TextBlock FontWeight="SemiBold" FontSize="15" Text="Cell Inspector" Margin="0,0,0,10" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Apply edits to"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding CellEditScopes}"
                                              SelectedItem="{Binding SelectedCellEditScope}"
                                              ToolTip="Selected cell creates/updates a private block for this cell. Shared template updates every cell using this block." />
                                </Grid>
                                <Border Height="340" Background="#20242a" BorderBrush="#d0d0d0" BorderThickness="1">
                                    <Viewport3D x:Name="SelectedCellPreviewViewport"
                                                Camera="{Binding SelectedCellPreview3DCamera}"
                                                ClipToBounds="True"
                                                Cursor="SizeAll"
                                                Focusable="True"
                                                MouseLeftButtonDown="InspectorPreview_MouseLeftButtonDown"
                                                MouseLeftButtonUp="InspectorPreview_MouseLeftButtonUp"
                                                MouseMove="InspectorPreview_MouseMove">
                                        <ModelVisual3D x:Name="SelectedCellPreviewModelVisual" />
                                    </Viewport3D>
                                </Border>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="↺" ToolTip="Rotate left" Width="36" Margin="0,0,4,0"
                                            Command="{Binding InspectorPreviewRotateLeftCommand}"
                                            CommandParameter="Cell" />
                                    <Button Content="↻" ToolTip="Rotate right" Width="36" Margin="0,0,8,0"
                                            Command="{Binding InspectorPreviewRotateRightCommand}"
                                            CommandParameter="Cell" />
                                    <Button Content="−" ToolTip="Zoom out" Width="36" Margin="0,0,4,0"
                                            Command="{Binding InspectorPreviewZoomOutCommand}"
                                            CommandParameter="Cell" />
                                    <Button Content="+" ToolTip="Zoom in" Width="36" Margin="0,0,8,0"
                                            Command="{Binding InspectorPreviewZoomInCommand}"
                                            CommandParameter="Cell" />
                                    <Button Content="←" ToolTip="Shift left" Width="36" Margin="0,0,4,0"
                                            Command="{Binding InspectorPreviewShiftLeftCommand}"
                                            CommandParameter="Cell" />
                                    <Button Content="→" ToolTip="Shift right" Width="36" Margin="0,0,4,0"
                                            Command="{Binding InspectorPreviewShiftRightCommand}"
                                            CommandParameter="Cell" />
                                    <Button Content="↑" ToolTip="Shift up" Width="36" Margin="0,0,4,0"
                                            Command="{Binding InspectorPreviewShiftUpCommand}"
                                            CommandParameter="Cell" />
                                    <Button Content="↓" ToolTip="Shift down" Width="36" Margin="0,0,8,0"
                                            Command="{Binding InspectorPreviewShiftDownCommand}"
                                            CommandParameter="Cell" />
                                    <Button Content="⛶" ToolTip="Fit preview" Width="36"
                                            Command="{Binding InspectorPreviewFitCommand}"
                                            CommandParameter="Cell" />
                                </WrapPanel>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Cell" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCell.Coordinates}" />
                                    <TextBlock Grid.Row="1" Text="Block" />
