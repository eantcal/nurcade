                                        <TextBlock Foreground="White" FontWeight="SemiBold"
                                                   Margin="0,0,0,6">
                                            <Run Text="Selected face: " />
                                            <Run Text="{Binding SelectedCellFaceLabel, Mode=OneWay}" FontWeight="Bold" Foreground="#ffdf58" />
                                        </TextBlock>
                                        <TextBlock Foreground="#cfd9e3" FontSize="11" TextWrapping="Wrap"
                                                   Text="Click any face in the 3D world preview to select it. Pick a texture from the Texture/Block Library and click Apply." />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding TextureChoices}"
                                                      ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                                      SelectedValuePath="Key"
                                                      SelectedValue="{Binding SelectedCellFaceTextureKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="1" Margin="6,0,0,0"
                                                    Content="Apply selected"
                                                    Command="{Binding ApplySelectedTextureToFaceCommand}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Player">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4" DataContext="{Binding PlayerStart}">
                                <TextBlock FontWeight="SemiBold" FontSize="15" Text="Player Start" Margin="0,0,0,10" />
