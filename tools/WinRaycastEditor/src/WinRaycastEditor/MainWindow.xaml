                                                 Grid.Column="1"
                                                 Width="80"
                                                 HorizontalAlignment="Left"
                                                 Text="{Binding SelectedCellDoorTriggerDistanceCells, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="3" Text="Open seconds" />
                                        <TextBox Grid.Row="3"
                                                 Grid.Column="1"
                                                 Width="80"
                                                 HorizontalAlignment="Left"
                                                 Text="{Binding SelectedCellDoorOpenTimeSeconds, UpdateSourceTrigger=PropertyChanged}" />
