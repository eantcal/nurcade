                                                  Grid.Column="1"
                                                  Width="120"
                                                  HorizontalAlignment="Left"
                                                  IsEditable="True"
                                                  ItemsSource="{Binding SelectedCellDoorKeyOptions}"
                                                  Text="{Binding SelectedCellDoorRequiredKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="2" Text="Trigger cells" />
