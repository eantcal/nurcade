                                             Text="{Binding XCell, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="2" Text="Y cell" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding YCell, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="3" Text="Facing" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding FacingDegrees, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Row="4" Grid.ColumnSpan="2"
                                            Margin="0,10,0,0"
                                            Content="Place at selected cell"
                                            Command="{Binding DataContext.PlacePlayerAtSelectedCellCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Grid>
                                <Separator Margin="0,12,0,8" />
                                <TextBlock FontWeight="SemiBold" Text="Player Combat" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Max health" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding DataContext.PlayerMaxHealth, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Text="Current health" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding DataContext.PlayerHealth, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Weapon">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4">
                                <TextBlock FontWeight="SemiBold" FontSize="15" Text="Weapon Library" Margin="0,0,0,10" />
                                <ListBox ItemsSource="{Binding WeaponLibrary}"
                                         SelectedItem="{Binding SelectedWeaponLibraryItem}"
                                         MaxHeight="118"
                                         Margin="0,0,0,8">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="Refresh"
                                            Command="{Binding RefreshWeaponLibraryCommand}"
                                            MinWidth="70"
                                            Margin="0,0,6,6" />
                                    <Button Content="Use as player"
                                            Command="{Binding UseSelectedWeaponAsPlayerCommand}"
                                            MinWidth="96"
                                            Margin="0,0,6,6" />
                                    <Button Content="Open JSON"
                                            Command="{Binding OpenWeaponJsonCommand}"
                                            MinWidth="84"
                                            Margin="0,0,6,6" />
                                    <Button Content="Clone"
                                            Command="{Binding CloneWeaponMetadataCommand}"
                                            MinWidth="64"
                                            Margin="0,0,6,6" />
                                    <Button Content="Remove player"
                                            Command="{Binding RemovePlayerWeaponCommand}"
                                            MinWidth="104"
                                            Margin="0,0,6,6" />
                                </WrapPanel>

                                <Separator />
                                <TextBlock FontWeight="SemiBold" FontSize="15" Text="Player Weapon" Margin="0,10,0,10" />
                                <TextBlock Margin="0,0,0,8" Text="{Binding PlayerWeaponSummary}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,0,0,8" FontSize="10" Foreground="#555"
                                           Text="{Binding WeaponMetadataPath}" TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="128" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="File" />
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding PlayerWeaponFile}" />
                                    <TextBlock Grid.Row="1" Text="Visible" />
                                    <CheckBox Grid.Row="1" Grid.Column="1"
                                              IsChecked="{Binding PlayerWeaponVisible}" />
                                    <TextBlock Grid.Row="2" Text="Override height %" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding PlayerWeaponScreenHeightPercent, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <WrapPanel Margin="0,8,0,10">
                                    <Button Content="Reload"
                                            Command="{Binding ReloadWeaponMetadataCommand}"
                                            MinWidth="70"
                                            Margin="0,0,6,6" />
                                    <Button Content="Save metadata"
                                            Command="{Binding SaveWeaponMetadataCommand}"
                                            MinWidth="104"
                                            Margin="0,0,6,6" />
                                    <Button Content="Save as"
                                            Command="{Binding SaveWeaponMetadataAsCommand}"
                                            MinWidth="70"
                                            Margin="0,0,6,6" />
                                </WrapPanel>

                                <Separator />
                                <TextBlock Margin="0,10,0,6" FontWeight="SemiBold" Text="Weapon Metadata" />
                                <TextBlock Margin="0,0,0,8" Text="{Binding WeaponMetadataSummary}" TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="128" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Name" />
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding WeaponName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Text="Format" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding WeaponFormat, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="2" Text="Frame size" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="64"
                                                 Text="{Binding WeaponFrameWidth, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="6,0" Text="x" VerticalAlignment="Center" />
                                        <TextBox Width="64"
                                                 Text="{Binding WeaponFrameHeight, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" Text="Default height %" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding WeaponMetadataScreenHeightPercent, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="4" Text="Anchor" />
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="64"
                                                 Text="{Binding WeaponAnchorX, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Width="64" Margin="6,0,0,0"
                                                 Text="{Binding WeaponAnchorY, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="5" Text="Base offset" />
                                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="64"
                                                 Text="{Binding WeaponBaseOffsetX, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Width="64" Margin="6,0,0,0"
                                                 Text="{Binding WeaponBaseOffsetY, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="6" Text="Weapon bob" />
                                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                                        <CheckBox Content="Enabled"
                                                  IsChecked="{Binding WeaponBobEnabled}"
                                                  VerticalAlignment="Center" />
                                        <TextBox Width="64" Margin="10,0,0,0"
                                                 ToolTip="Overall bob amount in percent"
                                                 Text="{Binding WeaponBobAmountPercent, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="4,0,0,0" Text="%" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="7" Text="Bob amplitude" />
                                    <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="64"
                                                 Text="{Binding WeaponBobAmplitudeX, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Width="64" Margin="6,0,0,0"
                                                 Text="{Binding WeaponBobAmplitudeY, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="8" Text="Bob frequency" />
                                    <TextBox Grid.Row="8" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding WeaponBobFrequencyHz, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="9" Text="Damage" />
                                    <TextBox Grid.Row="9" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding WeaponDamage, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="10" Text="Range cells" />
                                    <TextBox Grid.Row="10" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding WeaponRangeCells, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="11" Text="Fire sound" />
                                    <TextBox Grid.Row="11" Grid.Column="1"
                                             Text="{Binding WeaponFireSound, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="12" Text="Ammo" />
                                    <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="64"
                                                 ToolTip="Rounds loaded before reload"
                                                 Text="{Binding WeaponMagazineSize, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="6,0" Text="/" VerticalAlignment="Center" />
                                        <TextBox Width="64"
                                                 ToolTip="Maximum carried rounds"
                                                 Text="{Binding WeaponMaxAmmo, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="13" Text="Initial ammo" />
                                    <TextBox Grid.Row="13" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             ToolTip="-1 starts from maximum ammo"
                                             Text="{Binding WeaponInitialAmmo, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <TextBlock Margin="0,12,0,6" FontWeight="SemiBold" Text="Weapon Animations" />
                                <ListBox ItemsSource="{Binding WeaponAnimations}"
                                         SelectedItem="{Binding SelectedWeaponAnimation}"
                                         MaxHeight="96">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="88" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                <TextBlock Grid.Column="1" FontSize="10" Text="{Binding Summary}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="Add"
                                            Command="{Binding AddWeaponAnimationCommand}"
                                            MinWidth="58"
                                            Margin="0,0,6,6" />
                                    <Button Content="Duplicate"
                                            Command="{Binding DuplicateWeaponAnimationCommand}"
                                            MinWidth="78"
                                            Margin="0,0,6,6" />
                                    <Button Content="Remove"
                                            Command="{Binding RemoveWeaponAnimationCommand}"
                                            MinWidth="70"
                                            Margin="0,0,6,6" />
                                </WrapPanel>
                                <Grid DataContext="{Binding SelectedWeaponAnimation}" Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Frame ms" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Width="62"
                                             Text="{Binding FrameDurationMs, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Grid.Column="2"
                                              Content="Loop"
                                              IsChecked="{Binding Loop}"
                                              VerticalAlignment="Center"
                                              Margin="8,0,0,0" />
                                </Grid>
                                <ListBox ItemsSource="{Binding WeaponAnimationFrames}"
                                         SelectedItem="{Binding SelectedWeaponAnimationFrame}"
                                         MaxHeight="114"
                                         Margin="0,0,0,8">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding File, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="Add frame"
                                            Command="{Binding AddWeaponAnimationFrameCommand}"
                                            MinWidth="82"
                                            Margin="0,0,6,6" />
                                    <Button Content="Duplicate"
                                            Command="{Binding DuplicateWeaponAnimationFrameCommand}"
                                            MinWidth="78"
                                            Margin="0,0,6,6" />
                                    <Button Content="Remove"
                                            Command="{Binding RemoveWeaponAnimationFrameCommand}"
                                            MinWidth="70"
                                            Margin="0,0,6,6" />
                                </WrapPanel>
                                <Border Height="220"
                                        Background="#20242b"
                                        BorderBrush="#808894"
                                        BorderThickness="1"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Image Source="{Binding WeaponAnimationPlayback.CurrentPreview}"
                                               Stretch="Uniform"
                                               Margin="8" />
                                        <Border Background="#cc20242b"
                                                Padding="6,3"
                                                VerticalAlignment="Top"
                                                HorizontalAlignment="Right">
                                            <TextBlock Foreground="White"
                                                       FontSize="11"
                                                       Text="{Binding WeaponAnimationPlayback.Summary}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="|◀"
                                                ToolTip="Step backward one frame"
                                                Command="{Binding StepWeaponAnimationBackwardCommand}"
                                                MinWidth="36"
                                                Margin="0,0,4,0" />
                                        <Button Content="▶"
                                                ToolTip="Play animation"
                                                Command="{Binding PlayWeaponAnimationCommand}"
                                                MinWidth="36"
                                                Margin="0,0,4,0" />
                                        <Button Content="❚❚"
                                                ToolTip="Pause animation"
                                                Command="{Binding PauseWeaponAnimationCommand}"
                                                MinWidth="36"
                                                Margin="0,0,4,0" />
                                        <Button Content="■"
                                                ToolTip="Stop and rewind to first frame"
                                                Command="{Binding StopWeaponAnimationCommand}"
                                                MinWidth="36"
                                                Margin="0,0,4,0" />
                                        <Button Content="▶|"
                                                ToolTip="Step forward one frame"
                                                Command="{Binding StepWeaponAnimationForwardCommand}"
                                                MinWidth="36" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               Foreground="#555"
                                               Text="{Binding SelectedWeaponAnimationSummary}" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Block">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4" DataContext="{Binding SelectedBlock}">
                                <TextBlock FontWeight="SemiBold" FontSize="15" Text="Block Inspector" Margin="0,0,0,10" />
                                <Border Height="{Binding PreviewHeight}" Background="#20242a" BorderBrush="#d0d0d0" BorderThickness="1">
                                    <Viewport3D x:Name="SelectedBlockPreviewViewport"
                                                Camera="{Binding DataContext.SelectedBlockPreview3DCamera, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ClipToBounds="True"
                                                Cursor="SizeAll"
                                                Focusable="True"
                                                MouseLeftButtonDown="InspectorPreview_MouseLeftButtonDown"
                                                MouseLeftButtonUp="InspectorPreview_MouseLeftButtonUp"
                                                MouseMove="InspectorPreview_MouseMove">
                                        <ModelVisual3D x:Name="SelectedBlockPreviewModelVisual" />
                                    </Viewport3D>
                                </Border>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="↺" ToolTip="Rotate left" Width="36" Margin="0,0,4,0"
                                            Command="{Binding DataContext.InspectorPreviewRotateLeftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="Block" />
                                    <Button Content="↻" ToolTip="Rotate right" Width="36" Margin="0,0,8,0"
                                            Command="{Binding DataContext.InspectorPreviewRotateRightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="Block" />
                                    <Button Content="−" ToolTip="Zoom out" Width="36" Margin="0,0,4,0"
                                            Command="{Binding DataContext.InspectorPreviewZoomOutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="Block" />
                                    <Button Content="+" ToolTip="Zoom in" Width="36" Margin="0,0,8,0"
                                            Command="{Binding DataContext.InspectorPreviewZoomInCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="Block" />
                                    <Button Content="←" ToolTip="Shift left" Width="36" Margin="0,0,4,0"
                                            Command="{Binding DataContext.InspectorPreviewShiftLeftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="Block" />
                                    <Button Content="→" ToolTip="Shift right" Width="36" Margin="0,0,4,0"
                                            Command="{Binding DataContext.InspectorPreviewShiftRightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="Block" />
                                    <Button Content="↑" ToolTip="Shift up" Width="36" Margin="0,0,4,0"
                                            Command="{Binding DataContext.InspectorPreviewShiftUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="Block" />
                                    <Button Content="↓" ToolTip="Shift down" Width="36" Margin="0,0,8,0"
                                            Command="{Binding DataContext.InspectorPreviewShiftDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="Block" />
                                    <Button Content="⛶" ToolTip="Fit preview" Width="36"
                                            Command="{Binding DataContext.InspectorPreviewFitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="Block" />
                                </WrapPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Id" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Id}" />
                                    <TextBlock Grid.Row="1" Text="Name" />
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="2" Text="Floor" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox Width="150"
                                                  Margin="0,0,6,0"
                                                  ItemsSource="{Binding DataContext.TextureChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                                  SelectedValuePath="Key"
                                                  SelectedValue="{Binding FloorTexture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Width="70"
                                                 Text="{Binding FloorHeight, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" Text="Ceiling" />
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox Width="150"
                                                  Margin="0,0,6,0"
                                                  ItemsSource="{Binding DataContext.TextureChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                                  SelectedValuePath="Key"
                                                  SelectedValue="{Binding CeilingTexture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Width="70"
                                                 Text="{Binding CeilingHeight, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="4" Text="Horizon" />
                                    <TextBox Grid.Row="4" Grid.Column="1"
                                             Text="{Binding HorizonImage, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,4"
                                               FontWeight="SemiBold" Text="Wall spans" />
                                </Grid>
                                <GroupBox Header="{Binding DoorSummary}"
                                          Margin="0,8,0,8"
                                          Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0"
                                                    Grid.ColumnSpan="2"
                                                    Orientation="Horizontal"
                                                    Margin="0,0,0,6">
                                            <CheckBox IsChecked="{Binding DoorEnabled}"
                                                      Content="Animated door"
                                                      Margin="0,0,12,0" />
                                            <CheckBox IsChecked="{Binding DoorBlocksWhenClosed}"
                                                      Content="Blocks when closed" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="Required key" />
                                        <ComboBox Grid.Row="1"
                                                  Grid.Column="1"
                                                  Width="120"
                                                  HorizontalAlignment="Left"
                                                  IsEditable="True"
                                                  ItemsSource="{Binding DoorKeyOptions}"
                                                  Text="{Binding DoorRequiredKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="2" Text="Trigger cells" />
                                        <TextBox Grid.Row="2"
                                                 Grid.Column="1"
                                                 Width="80"
                                                 HorizontalAlignment="Left"
                                                 Text="{Binding DoorTriggerDistanceCells, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="3" Text="Open seconds" />
                                        <TextBox Grid.Row="3"
                                                 Grid.Column="1"
                                                 Width="80"
                                                 HorizontalAlignment="Left"
                                                 Text="{Binding DoorOpenTimeSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="4" Text="Close delay" />
                                        <TextBox Grid.Row="4"
                                                 Grid.Column="1"
                                                 Width="80"
                                                 HorizontalAlignment="Left"
                                                 Text="{Binding DoorCloseDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="5" Text="Lock overlays" />
                                        <Grid Grid.Row="5" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Green" />
                                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,3"
                                                      ItemsSource="{Binding DataContext.TextureChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                                      SelectedValuePath="Key"
                                                      SelectedValue="{Binding DoorGreenOverlayTexture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Row="1" Text="Blue" />
                                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,3"
                                                      ItemsSource="{Binding DataContext.TextureChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                                      SelectedValuePath="Key"
                                                      SelectedValue="{Binding DoorBlueOverlayTexture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Row="2" Text="Red" />
                                            <ComboBox Grid.Row="2" Grid.Column="1"
                                                      ItemsSource="{Binding DataContext.TextureChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                                      SelectedValuePath="Key"
                                                      SelectedValue="{Binding DoorRedOverlayTexture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <TextBlock Grid.Row="6" Text="Frames" />
                                        <StackPanel Grid.Row="6" Grid.Column="1">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Button Content="Add" MinWidth="44" Command="{Binding AddDoorFrameCommand}" />
                                                <Button Content="Remove" MinWidth="58" Margin="4,0,0,0" Command="{Binding RemoveDoorFrameCommand}" />
                                                <Button Content="Up" MinWidth="36" Margin="8,0,0,0" Command="{Binding MoveDoorFrameUpCommand}" />
                                                <Button Content="Down" MinWidth="44" Margin="4,0,0,0" Command="{Binding MoveDoorFrameDownCommand}" />
                                            </StackPanel>
                                            <ListBox ItemsSource="{Binding DoorFrames}"
                                                     SelectedItem="{Binding SelectedDoorFrame}"
                                                     MaxHeight="220"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#80808080" BorderThickness="1" Margin="3" Padding="3" Background="#fafafa">
                                                            <StackPanel Width="80">
                                                                <Image Source="{Binding Preview}" Width="74" Height="74"
                                                                       Stretch="UniformToFill"
                                                                       Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <TextBlock Text="{Binding Display}" FontSize="10" HorizontalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>
                                <GroupBox Header="Block structure"
                                          Margin="0,0,0,8"
                                          Padding="8">
                                    <GroupBox.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type local:BlockTreeNodeViewModel}"
                                                                  ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Preview}"
                                                       Width="20"
                                                       Height="20"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Stretch="Uniform"
                                                       Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </GroupBox.Resources>
                                    <TreeView ItemsSource="{Binding StructureTree}"
                                              MaxHeight="220" />
                                </GroupBox>
                                <GroupBox Header="Block animations"
                                          Margin="0,0,0,8"
                                          Padding="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding AnimationSummary}"
                                                   Foreground="#555"
                                                   Margin="0,0,0,4" />
                                        <ListBox Grid.Row="1"
                                                 ItemsSource="{Binding Animations}"
                                                 SelectedItem="{Binding SelectedAnimation}"
                                                 DisplayMemberPath="Display"
                                                 MaxHeight="100" />
                                        <StackPanel Grid.Row="2"
                                                    Margin="0,6,0,0">
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,0,0,6">
                                                <Button Content="Add animation"
                                                        Command="{Binding AddAnimationCommand}"
                                                        Margin="0,0,6,0" />
                                                <Button Content="Remove animation"
                                                        Command="{Binding RemoveAnimationCommand}" />
                                            </StackPanel>
                                            <Grid DataContext="{Binding SelectedAnimation}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Name" />
                                                <TextBox Grid.Row="0" Grid.Column="1"
                                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Row="1" Text="Target" />
                                                <ComboBox Grid.Row="1" Grid.Column="1"
                                                          ItemsSource="{Binding DataContext.SelectedBlock.AnimationTargets, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding Target, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Row="2" Text="Wall / face" />
                                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                                    <TextBox Width="54"
                                                             Margin="0,0,6,0"
                                                             Text="{Binding WallIndexText, UpdateSourceTrigger=PropertyChanged}" />
                                                    <ComboBox Width="110"
                                                              ItemsSource="{Binding DataContext.SelectedBlock.AnimationFaces, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding Face, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <TextBlock Grid.Row="3" Text="Frame ms" />
                                                <TextBox Grid.Row="3" Grid.Column="1"
                                                         Width="72"
                                                         HorizontalAlignment="Left"
                                                         Text="{Binding FrameDurationMs, UpdateSourceTrigger=PropertyChanged}" />
                                                <CheckBox Grid.Row="4" Grid.Column="1"
                                                          Content="Loop"
                                                          IsChecked="{Binding Loop}" />
                                                <TextBlock Grid.Row="5" Text="Frames" />
                                                <TextBox Grid.Row="5" Grid.Column="1"
                                                         MinHeight="54"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Text="{Binding FramesText, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="Add span"
                                            Command="{Binding AddWallSpanCommand}"
                                            Margin="0,0,6,0" />
                                    <Button Content="Remove span"
                                            Command="{Binding RemoveWallSpanCommand}" />
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Walls}"
                                         SelectedItem="{Binding SelectedWallSpan}"
                                         MaxHeight="260"
                                         Margin="0,6,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="54" />
                                                    <ColumnDefinition Width="54" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{Binding DataContext.WallKinds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox Grid.Column="1" Margin="4,0,0,0"
                                                         Text="{Binding Bottom, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox Grid.Column="2" Margin="4,0,0,0"
                                                         Text="{Binding Top, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0,0,0">
                                                    <ComboBox Width="132"
                                                              ItemsSource="{Binding DataContext.TextureChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                                              SelectedValuePath="Key"
                                                              SelectedValue="{Binding Texture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <CheckBox Margin="6,0,0,0" VerticalAlignment="Center"
                                                              IsChecked="{Binding Passable}"
                                                              Content="Passable" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1"
                                                             Grid.ColumnSpan="4"
                                                             Margin="0,4,0,0">
                                                    <TextBlock Text="Per-face: enable + texture override per side" FontSize="10" Foreground="#777" Margin="0,0,0,3" />
                                                    <UniformGrid Columns="2" Rows="2">
                                                        <StackPanel Orientation="Horizontal" Margin="0,1,4,1">
                                                            <CheckBox VerticalAlignment="Center" Margin="0,0,4,0"
                                                                      IsChecked="{Binding NorthEnabled, Mode=TwoWay}"
                                                                      ToolTip="Render this wall span on the north face" />
                                                            <TextBlock Text="N" Width="14" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                            <ComboBox Width="130"
                                                                      IsEnabled="{Binding NorthEnabled}"
                                                                      ItemsSource="{Binding DataContext.TextureChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                                                      SelectedValuePath="Key"
                                                                      SelectedValue="{Binding NorthTexture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                                            <CheckBox VerticalAlignment="Center" Margin="0,0,4,0"
                                                                      IsChecked="{Binding EastEnabled, Mode=TwoWay}"
                                                                      ToolTip="Render this wall span on the east face" />
                                                            <TextBlock Text="E" Width="14" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                            <ComboBox Width="130"
                                                                      IsEnabled="{Binding EastEnabled}"
                                                                      ItemsSource="{Binding DataContext.TextureChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                                                      SelectedValuePath="Key"
                                                                      SelectedValue="{Binding EastTexture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,1,4,1">
                                                            <CheckBox VerticalAlignment="Center" Margin="0,0,4,0"
                                                                      IsChecked="{Binding SouthEnabled, Mode=TwoWay}"
                                                                      ToolTip="Render this wall span on the south face" />
                                                            <TextBlock Text="S" Width="14" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                            <ComboBox Width="130"
                                                                      IsEnabled="{Binding SouthEnabled}"
                                                                      ItemsSource="{Binding DataContext.TextureChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                                                      SelectedValuePath="Key"
                                                                      SelectedValue="{Binding SouthTexture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,1">
                                                            <CheckBox VerticalAlignment="Center" Margin="0,0,4,0"
                                                                      IsChecked="{Binding WestEnabled, Mode=TwoWay}"
                                                                      ToolTip="Render this wall span on the west face" />
                                                            <TextBlock Text="W" Width="14" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                            <ComboBox Width="130"
                                                                      IsEnabled="{Binding WestEnabled}"
                                                                      ItemsSource="{Binding DataContext.TextureChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                                                      SelectedValuePath="Key"
                                                                      SelectedValue="{Binding WestTexture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Validation">
                        <DockPanel Margin="4">
                            <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="15" Text="Validation" Margin="0,0,0,10" />
                            <ListBox ItemsSource="{Binding ValidationMessages}" />
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Help">
                        <StackPanel Margin="4">
                    <TextBlock Margin="0,12,0,6" FontWeight="SemiBold" Text="Legend" />
                    <TextBlock Text="2H = two-block wall" />
                    <TextBlock Text="T = transparent wall (visual only)" />
                    <TextBlock Text="Passable = movement can cross the span" />
                    <TextBlock Text="S# = sprites in cell" />
                    <TextBlock Text="P = player start" />
                    <TextBlock Text="G = final game cell" />
                    <TextBlock Text="H = horizon marker" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#d8d8d8"
                          ShowsPreview="True" />

            <Border Grid.Column="2" Margin="12,0" Background="White" BorderBrush="#d0d0d0" BorderThickness="1" Padding="12">
                <TabControl>
                    <TabItem Header="Map Grid">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Margin="0,0,6,0"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Text="Layer" />
                            <ComboBox MinWidth="150"
                                      ItemsSource="{Binding LayerModes}"
                                      SelectedItem="{Binding SelectedLayer}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="-" Width="28" Command="{Binding ZoomOutCommand}" />
                            <TextBlock Width="48" Text="{Binding MapZoomText}" TextAlignment="Center" VerticalAlignment="Center" />
                            <Button Content="+" Width="28" Command="{Binding ZoomInCommand}" />
                            <Button Content="Reset" Width="52" Margin="6,0,0,0" Command="{Binding ResetZoomCommand}" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="N"
                                   FontWeight="Bold" FontSize="13" Foreground="#c2185b"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="S"
                                   FontWeight="Bold" FontSize="13" Foreground="#c2185b"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="W"
                                   FontWeight="Bold" FontSize="13" Foreground="#c2185b"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="E"
                                   FontWeight="Bold" FontSize="13" Foreground="#c2185b"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ScrollViewer x:Name="MapScrollViewer"
                                  Grid.Row="1" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <ListBox ItemsSource="{Binding Cells}"
                                 SelectedItem="{Binding SelectedCell}"
                                 SelectionMode="Extended"
                                 SelectionChanged="MapCells_SelectionChanged"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.Width>
                                <MultiBinding Converter="{StaticResource MapGridSizeConverter}" ConverterParameter="GridWidth">
                                    <Binding ElementName="MapScrollViewer" Path="ActualWidth" />
                                    <Binding Path="Document.ColumnCount" />
                                    <Binding Path="MapZoomScale" />
                                </MultiBinding>
                            </ListBox.Width>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding DataContext.Document.ColumnCount, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#66808080"
                                            BorderThickness="0.5"
                                            Background="{Binding Background}"
                                            AllowDrop="True"
                                            DragOver="MapCell_DragOver"
                                            Drop="MapCell_Drop"
                                            MouseLeftButtonDown="MapCell_MouseDoubleClick"
                                            PreviewMouseLeftButtonDown="SpriteDrag_PreviewMouseLeftButtonDown"
                                            MouseMove="SpriteDrag_MouseMove">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource MapGridSizeConverter}">
                                                <Binding ElementName="MapScrollViewer" Path="ActualWidth" />
                                                <Binding Path="DataContext.Document.ColumnCount" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                <Binding Path="DataContext.MapZoomScale" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                            </MultiBinding>
                                        </Border.Width>
                                        <Border.Height>
                                            <MultiBinding Converter="{StaticResource MapGridSizeConverter}">
                                                <Binding ElementName="MapScrollViewer" Path="ActualWidth" />
                                                <Binding Path="DataContext.Document.ColumnCount" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                <Binding Path="DataContext.MapZoomScale" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                            </MultiBinding>
                                        </Border.Height>
                                    <Grid x:Name="CellVisual" ClipToBounds="True">
                                        <Image Source="{Binding ActiveTexturePreview}" Stretch="UniformToFill" Opacity="0.95" />
                                        <Border Background="#66000000">
                                            <Grid Margin="3">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock FontSize="10" Foreground="White" Text="{Binding Kind}" />
                                                <TextBlock Grid.Row="1" FontSize="10" Foreground="White"
                                                           Text="{Binding PackedValue}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasActiveTexturePreview}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Row="2" FontSize="10" FontWeight="SemiBold" Foreground="White" Text="{Binding Badges}" />
                                                <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Background="#cc0a4a8a" CornerRadius="3" Padding="3,1"
                                                        Visibility="{Binding HasTargetLayerLabel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Foreground="White" FontSize="9" FontWeight="Bold">
                                                        <Run Text="-> " />
                                                        <Run Text="{Binding TargetLayerLabel, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Image Source="{Binding SpritePreview}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                            <Image.Width>
                                                <MultiBinding Converter="{StaticResource SpriteMapMarkerSizeConverter}">
                                                    <Binding ElementName="CellVisual" Path="ActualWidth" />
                                                    <Binding Path="SpritePreviewScaleCells" />
                                                </MultiBinding>
                                            </Image.Width>
                                            <Image.Height>
                                                <MultiBinding Converter="{StaticResource SpriteMapMarkerSizeConverter}">
                                                    <Binding ElementName="CellVisual" Path="ActualHeight" />
                                                    <Binding Path="SpritePreviewScaleCells" />
                                                </MultiBinding>
                                            </Image.Height>
                                            <Image.RenderTransform>
                                                <TranslateTransform>
                                                    <TranslateTransform.X>
                                                        <MultiBinding Converter="{StaticResource SpriteMapMarkerOffsetConverter}">
                                                            <Binding ElementName="CellVisual" Path="ActualWidth" />
                                                            <Binding Path="SpritePreviewOffsetX" />
                                                        </MultiBinding>
                                                    </TranslateTransform.X>
                                                    <TranslateTransform.Y>
                                                        <MultiBinding Converter="{StaticResource SpriteMapMarkerOffsetConverter}">
                                                            <Binding ElementName="CellVisual" Path="ActualHeight" />
                                                            <Binding Path="SpritePreviewOffsetY" />
                                                        </MultiBinding>
                                                    </TranslateTransform.Y>
                                                </TranslateTransform>
                                            </Image.RenderTransform>
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowSpritePreview}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <Border Width="24" Height="24"
                                                Background="#d9f35b22"
                                                BorderBrush="White"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowSpriteMarker}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding SpriteMarkerText}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Border Width="28" Height="20"
                                                Background="#d9336d92"
                                                BorderBrush="White"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowHorizonMarker}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="H"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Border Width="26" Height="26"
                                                Background="#d9206ac7"
                                                BorderBrush="White"
                                                BorderThickness="1"
                                                CornerRadius="13"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Cursor="Hand"
                                                ToolTip="Drag to move the player start"
                                                PreviewMouseLeftButtonDown="PlayerDrag_PreviewMouseLeftButtonDown"
                                                MouseMove="PlayerDrag_MouseMove">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowPlayerMarker}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="P"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Border Width="28" Height="28"
                                                Background="#d91b7f45"
                                                BorderBrush="#fff176"
                                                BorderThickness="2"
                                                CornerRadius="4"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowGameGoalMarker}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="G"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Border IsHitTestVisible="False"
                                                BorderBrush="#ffde00"
                                                BorderThickness="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="Opacity" Value="0.95" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <Border IsHitTestVisible="False"
                                                Margin="5"
                                                BorderBrush="#cc000000"
                                                BorderThickness="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                    </Grid>
                </DockPanel>
                    </TabItem>
                    <TabItem Header="3D Map View"
                            IsSelected="True">
                        <Grid Background="#20242a">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Padding="8" Background="#f5ffffff" BorderBrush="#d0d0d0" BorderThickness="1,0,1,1">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="{Binding Preview3DViewMode, StringFormat=View: {0}}" />
                                        <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <Button Content="Angled" Width="64" Margin="4,0,0,0" Command="{Binding PreviewAngledCameraCommand}" />
                                            <Button Content="Top" Width="52" Margin="4,0,0,0" Command="{Binding PreviewTopCameraCommand}" />
                                            <Button Content="Perspective" Width="86" Margin="4,0,0,0" Command="{Binding PreviewPlayerCameraCommand}" />
                                            <Button Content="⛶" ToolTip="Fit preview" Width="36" Margin="12,0,0,0" Command="{Binding PreviewFitAllCommand}" />
                                            <Button Content="−" ToolTip="Zoom out" Width="36" Margin="4,0,0,0" Command="{Binding PreviewZoomOutCommand}" />
                                            <Button Content="+" ToolTip="Zoom in" Width="36" Margin="4,0,0,0" Command="{Binding PreviewZoomInCommand}" />
                                            <Button Content="↺" ToolTip="Rotate left" Width="36" Margin="12,0,0,0" Command="{Binding PreviewRotateLeftCommand}" />
                                            <Button Content="↻" ToolTip="Rotate right" Width="36" Margin="4,0,0,0" Command="{Binding PreviewRotateRightCommand}" />
                                            <Button Content="↑" ToolTip="Move forward / scroll up" Width="36" Margin="12,0,0,0" Command="{Binding PreviewMoveForwardCommand}" />
                                            <Button Content="↓" ToolTip="Move backward / scroll down" Width="36" Margin="4,0,0,0" Command="{Binding PreviewMoveBackwardCommand}" />
                                            <Button Content="←" ToolTip="Strafe left / scroll left" Width="36" Margin="4,0,0,0" Command="{Binding PreviewStrafeLeftCommand}" />
                                            <Button Content="→" ToolTip="Strafe right / scroll right" Width="36" Margin="4,0,0,0" Command="{Binding PreviewStrafeRightCommand}" />
                                        </WrapPanel>
                                    </DockPanel>
                                    <WrapPanel Margin="0,8,0,0">
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Layers:" />
                                        <CheckBox Content="Floor" Margin="10,0,0,0" IsChecked="{Binding PreviewShowFloors}" />
                                        <CheckBox Content="Ceil" Margin="10,0,0,0" IsChecked="{Binding PreviewShowCeilings}" />
                                        <CheckBox Content="Walls" Margin="10,0,0,0" IsChecked="{Binding PreviewShowWalls}" />
                                        <CheckBox Content="Sprites" Margin="10,0,0,0" IsChecked="{Binding PreviewShowSprites}" />
                                        <CheckBox Content="Player" Margin="10,0,0,0" IsChecked="{Binding PreviewShowPlayer}" />
                                        <CheckBox Content="Grid" Margin="10,0,0,0" IsChecked="{Binding PreviewShowGrid}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1" Background="#20242a" ClipToBounds="True">
                                <Image Source="{Binding PreviewBackgroundImage}"
                                       Stretch="UniformToFill"
                                       Opacity="0.9" />
                                <Viewport3D x:Name="WorldPreviewViewport"
                                            Camera="{Binding Preview3DCamera}"
                                            ClipToBounds="True"
                                            Cursor="SizeAll"
                                            Focusable="True"
                                            KeyDown="WorldPreviewViewport_KeyDown"
                                            MouseLeftButtonDown="WorldPreviewViewport_MouseLeftButtonDown"
                                            MouseLeftButtonUp="WorldPreviewViewport_MouseLeftButtonUp"
                                            MouseMove="WorldPreviewViewport_MouseMove"
                                            MouseWheel="WorldPreviewViewport_MouseWheel">
                                    <ModelVisual3D x:Name="WorldPreviewModelVisual" />
                                </Viewport3D>
                                <Border HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Margin="12"
                                        Padding="10,8"
                                        Background="#d0181b20"
                                        BorderBrush="#80ffffff"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Preview3DViewMode}" Value="Perspective">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Width="132">
                                            <TextBlock Foreground="#ffdf58"
                                                       FontWeight="Bold"
                                                       FontSize="11"
                                                       Text="HEALTH" />
                                            <ProgressBar Height="12"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding PreviewHudHealthPercent, Mode=OneWay}"
                                                         Foreground="#c01828"
                                                         Background="#303030" />
                                            <TextBlock Foreground="White"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding PreviewHudHealthText}" />
                                        </StackPanel>
                                        <Border Width="1" Margin="12,0" Background="#60ffffff" />
                                        <StackPanel MinWidth="160">
                                            <TextBlock Foreground="#ffdf58"
                                                       FontWeight="Bold"
                                                       FontSize="11"
                                                       Text="WEAPON" />
                                            <TextBlock Foreground="White"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding PreviewHudWeaponText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Grid.Row="2" Padding="8" Background="#f5ffffff" BorderBrush="#d0d0d0" BorderThickness="1,1,1,0">
                                <TextBlock Text="{Binding Preview3DSummary}" />
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="3"
                          Visibility="{Binding JsonPanel.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#d8d8d8"
                          ShowsPreview="True" />

            <Border Grid.Column="4"
                    Background="White" BorderBrush="#d0d0d0" BorderThickness="1"
                    Visibility="{Binding JsonPanel.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel DataContext="{Binding JsonPanel}" Margin="6">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="JSON Editor" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="#667085" TextWrapping="Wrap"
                                   Text="Edit properties directly as JSON. Selecting a cell, sprite, or block highlights its fragment. World JSON is backed up to a .bak file while edits are pending." />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <RadioButton Content="World JSON" GroupName="JsonScope" Margin="0,0,12,0"
                                         IsChecked="{Binding IsWholeWorldScope, Mode=OneWay}"
                                         Command="{Binding ShowWholeWorldCommand}" />
                            <RadioButton Content="Selection" GroupName="JsonScope"
                                         IsChecked="{Binding IsSelectionScope, Mode=OneWay}"
                                         Command="{Binding ShowSelectionCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                            <Button Content="Apply" MinWidth="64" Command="{Binding ApplyCommand}"
                                    ToolTip="Validate the JSON and apply it back to the editor model." />
                            <Button Content="Revert" MinWidth="64" Margin="6,0,0,0" Command="{Binding RevertCommand}"
                                    ToolTip="Discard edits and rebuild the JSON from the current model." />
                            <Button Content="Format" MinWidth="64" Margin="6,0,0,0" Command="{Binding FormatCommand}"
                                    ToolTip="Re-indent (pretty-print) the JSON." />
                        </StackPanel>
                        <Grid Margin="0,2,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,4,0" Text="Find" />
                                <TextBox Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <DockPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,4">
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,4,0" Text="Replace" />
                                <TextBox Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                                <Button Content="Next" MinWidth="54" Command="{Binding FindNextCommand}" />
                                <Button Content="Replace" MinWidth="64" Margin="6,0,0,0" Command="{Binding ReplaceCommand}" />
                                <Button Content="All" MinWidth="48" Margin="6,0,0,0" Command="{Binding ReplaceAllCommand}" />
                                <CheckBox Content="Case" Margin="10,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{Binding FindCaseSensitive}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Margin="0,6,0,0" Padding="6"
                            Background="#f7f7f7" BorderBrush="#e0e0e0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="11" />
                            <ItemsControl ItemsSource="{Binding Errors}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#b00020" FontSize="11" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <local:JsonScintillaHost Text="{Binding JsonText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </Border>

            <TabControl Grid.Column="4" TabStripPlacement="Left" Visibility="Collapsed">
                <TabItem Header="Cell">
                <Border Background="White" BorderBrush="#d0d0d0" BorderThickness="1" Padding="12">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" FontSize="15" Text="Cell Inspector" Margin="0,0,0,10" />
                        <Grid DataContext="{Binding SelectedCell}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Coordinates" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Coordinates}" />
                            <TextBlock Grid.Row="1" Text="Packed" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PackedValue}" />
                            <TextBlock Grid.Row="2" Text="Wall" />
                            <TextBox Grid.Row="2" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding SolidWallTexture, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="3" Text="Floor" />
                            <TextBox Grid.Row="3" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding FloorTextureId, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="4" Text="Ceiling" />
                            <TextBox Grid.Row="4" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding CeilingTextureId, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="5" Text="Transparent" />
                            <TextBox Grid.Row="5" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding TransparentWallTextureId, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="6" Text="Upper wall" />
                            <TextBox Grid.Row="6" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding UpperWallTextureId, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="7" Text="Sprites" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SpriteCount}" />
                            <TextBlock Grid.Row="8" Text="Kind" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Kind}" />
                            <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Clear walls" MinWidth="92" Margin="0,0,8,0"
                                        Command="{Binding ClearWallsCommand}" />
                                <Button Content="Clear floor/ceiling" MinWidth="126"
                                        Command="{Binding ClearSurfacesCommand}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                </TabItem>

                <TabItem Header="Sprite">
                <Border Background="White" BorderBrush="#d0d0d0" BorderThickness="1" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedSprite}">
                        <TextBlock FontWeight="SemiBold" FontSize="15" Text="Sprite Inspector" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Name" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="1" Text="Sprite set" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SpriteSet}" />
                            <TextBlock Grid.Row="2" Text="X cell" />
                            <TextBox Grid.Row="2" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding XCell, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="3" Text="Y cell" />
                            <TextBox Grid.Row="3" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding YCell, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="4" Text="Facing" />
                            <TextBox Grid.Row="4" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding FacingDegrees, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="5" Text="Scale" />
                            <TextBox Grid.Row="5" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding ScaleCells, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="6" Text="Collision radius" />
                            <TextBox Grid.Row="6" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding CollisionRadiusCells, UpdateSourceTrigger=LostFocus}" />
                            <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox Content="Visible" IsChecked="{Binding Visible}" Margin="0,0,12,0" />
                                <CheckBox Content="Pass-through walls" IsChecked="{Binding PassThroughWalls}" />
                                <CheckBox Content="Save point" IsChecked="{Binding SavePoint}" Margin="12,0,0,0"
                                          Visibility="{Binding IsItem, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                        <Border Margin="0,12,0,0" Padding="8,6" Background="#eef3ec" BorderBrush="#cfdcc8" BorderThickness="1"
                                Visibility="{Binding IsItem, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="#3c5a32"
                                           Text="Item sprite: placed as a static, pass-through pickup. Behaviour and combat stats do not apply." />
                                <Separator Margin="0,8,0,6" />
                                <TextBlock FontWeight="SemiBold" Text="Explosive item" Margin="0,0,0,6" />
                                <CheckBox Content="Explodes when hit"
                                          IsChecked="{Binding Explosive}" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Hit points" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding ExplosiveHitPoints, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="1" Text="Radius cells" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding ExplosionRadiusCells, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="2" Text="Damage" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding ExplosionDamage, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="3" Text="Explosion scale" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding ExplosionScaleCells, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="4" Text="Explosion set" />
                                    <TextBox Grid.Row="4" Grid.Column="1"
                                             Text="{Binding ExplosionSpriteSet, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="5" Text="Destroyed set" />
                                    <TextBox Grid.Row="5" Grid.Column="1"
                                             Text="{Binding DestroyedSpriteSet, UpdateSourceTrigger=LostFocus}" />
                                     <TextBlock Grid.Row="6" Text="Destroyed scale" />
                                     <TextBox Grid.Row="6" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                              Text="{Binding DestroyedScaleCells, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="7" Text="Response type" Margin="0,8,0,0" />
                                    <TextBox Grid.Row="7" Grid.Column="1" Margin="0,8,0,0"
                                             Text="{Binding DamageResponseType, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="8" Text="Response HP" />
                                    <TextBox Grid.Row="8" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding DamageResponseHitPoints, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="9" Text="Effect set" />
                                    <TextBox Grid.Row="9" Grid.Column="1"
                                             Text="{Binding DamageEffectSpriteSet, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="10" Text="Effect animation" />
                                    <TextBox Grid.Row="10" Grid.Column="1"
                                             Text="{Binding DamageEffectAnimation, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="11" Text="Effect scale" />
                                    <TextBox Grid.Row="11" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding DamageEffectScaleCells, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="12" Text="Final set" />
                                    <TextBox Grid.Row="12" Grid.Column="1"
                                             Text="{Binding DamageDestroyedSpriteSet, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="13" Text="Final scale" />
                                    <TextBox Grid.Row="13" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                             Text="{Binding DamageDestroyedScaleCells, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="14" Text="Sound" />
                                    <TextBox Grid.Row="14" Grid.Column="1"
                                             Text="{Binding DamageSound, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Grid.Row="15" Text="Radius/damage" />
                                    <StackPanel Grid.Row="15" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="72" HorizontalAlignment="Left"
                                                 Text="{Binding DamageRadiusCells, UpdateSourceTrigger=LostFocus}" />
                                        <TextBox Width="72" Margin="6,0,0,0" HorizontalAlignment="Left"
                                                 Text="{Binding DamageAmount, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                 </Grid>
                            </StackPanel>
                        </Border>
                        <StackPanel Visibility="{Binding IsItem, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Separator Margin="0,12,0,8" />
                        <TextBlock FontWeight="SemiBold" Text="Behavior" Margin="0,0,0,6" />
                        <StackPanel Orientation="Vertical">
                            <CheckBox Content="Chase player in detection radius"
                                      IsChecked="{Binding ChasePlayer}" />
                            <CheckBox Content="Patrol circuit inside home radius"
                                      IsChecked="{Binding PatrolCircuit}"
                                      Margin="0,4,0,0" />
                        </StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Speed" />
                            <TextBox Grid.Row="0" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding SpeedCellsPerSecond, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="1" Text="Detection radius" />
                            <TextBox Grid.Row="1" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding DetectionRadiusCells, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="2" Text="Patrol radius" />
                            <TextBox Grid.Row="2" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding PatrolRadiusCells, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="3" Text="Hysteresis" />
                            <TextBox Grid.Row="3" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding EngagementHysteresisCells, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="4" Text="Stop distance" />
                            <TextBox Grid.Row="4" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding StoppingDistanceCells, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                        <Separator Margin="0,12,0,8" />
                        <TextBlock FontWeight="SemiBold" Text="Combat" Margin="0,0,0,6" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Max health" />
                            <TextBox Grid.Row="0" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding MaxHealth, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="1" Text="Current health" />
                            <TextBox Grid.Row="1" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding Health, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Row="2" Text="Attack damage" />
                            <TextBox Grid.Row="2" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding AttackDamage, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
                </TabItem>

                <TabItem Header="Player">
                <Border Background="White" BorderBrush="#d0d0d0" BorderThickness="1" Padding="12">
                    <StackPanel DataContext="{Binding PlayerStart}">
                        <TextBlock FontWeight="SemiBold" FontSize="15" Text="Player Start" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Position" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Position}" />
                            <TextBlock Grid.Row="1" Text="X cell" />
                            <TextBox Grid.Row="1" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding XCell, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="2" Text="Y cell" />
                            <TextBox Grid.Row="2" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding YCell, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="3" Text="Facing" />
                            <TextBox Grid.Row="3" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding FacingDegrees, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Row="4" Grid.ColumnSpan="2"
                                    Margin="0,10,0,0"
                                    Content="Place at selected cell"
                                    Command="{Binding DataContext.PlacePlayerAtSelectedCellCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Grid>
                        <Separator Margin="0,12,0,8" />
                        <TextBlock FontWeight="SemiBold" Text="Player Combat" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Max health" />
                            <TextBox Grid.Row="0" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding DataContext.PlayerMaxHealth, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Text="Current health" />
                            <TextBox Grid.Row="1" Grid.Column="1" Width="72" HorizontalAlignment="Left"
                                     Text="{Binding DataContext.PlayerHealth, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </Border>
                </TabItem>

                <TabItem Header="Block">
                <Border Background="White" BorderBrush="#d0d0d0" BorderThickness="1" Padding="12">
                    <StackPanel DataContext="{Binding SelectedBlock}">
                        <TextBlock FontWeight="SemiBold" FontSize="15" Text="Block Inspector" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Id" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Id}" />
                            <TextBlock Grid.Row="1" Text="Name" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="2" Text="Floor" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Width="70" Margin="0,0,6,0"
                                         Text="{Binding FloorTexture, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Width="70"
                                         Text="{Binding FloorHeight, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="Ceiling" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Width="70" Margin="0,0,6,0"
                                         Text="{Binding CeilingTexture, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Width="70"
                                         Text="{Binding CeilingHeight, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <TextBlock Grid.Row="4" Text="Horizon" />
                            <TextBox Grid.Row="4" Grid.Column="1"
                                     Text="{Binding HorizonImage, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,4"
                                       FontWeight="SemiBold" Text="Wall spans" />
                        </Grid>
                        <GroupBox Header="{Binding DoorSummary}"
                                  Margin="0,8,0,8"
                                  Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0"
                                            Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            Margin="0,0,0,6">
                                    <CheckBox IsChecked="{Binding DoorEnabled}"
                                              Content="Animated door"
                                              Margin="0,0,12,0" />
                                    <CheckBox IsChecked="{Binding DoorBlocksWhenClosed}"
                                              Content="Blocks when closed" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="Required key" />
                                <ComboBox Grid.Row="1"
                                          Grid.Column="1"
                                          Width="120"
                                          HorizontalAlignment="Left"
                                          IsEditable="True"
                                          ItemsSource="{Binding DoorKeyOptions}"
                                          Text="{Binding DoorRequiredKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Text="Trigger cells" />
                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         Width="80"
                                         HorizontalAlignment="Left"
                                         Text="{Binding DoorTriggerDistanceCells, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="3" Text="Open seconds" />
                                <TextBox Grid.Row="3"
                                         Grid.Column="1"
                                         Width="80"
                                         HorizontalAlignment="Left"
                                         Text="{Binding DoorOpenTimeSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="4" Text="Close delay" />
                                <TextBox Grid.Row="4"
                                         Grid.Column="1"
                                         Width="80"
                                         HorizontalAlignment="Left"
                                         Text="{Binding DoorCloseDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="5" Text="Lock overlays" />
                                <Grid Grid.Row="5" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Green" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,3"
                                              ItemsSource="{Binding DataContext.TextureChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                              ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                              SelectedValuePath="Key"
                                              SelectedValue="{Binding DoorGreenOverlayTexture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Text="Blue" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,3"
                                              ItemsSource="{Binding DataContext.TextureChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                              ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                              SelectedValuePath="Key"
                                              SelectedValue="{Binding DoorBlueOverlayTexture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="2" Text="Red" />
                                    <ComboBox Grid.Row="2" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.TextureChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                              ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                              SelectedValuePath="Key"
                                              SelectedValue="{Binding DoorRedOverlayTexture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <TextBlock Grid.Row="6" Text="Frames" />
                                <StackPanel Grid.Row="6" Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Content="Add" MinWidth="44" Command="{Binding AddDoorFrameCommand}" />
                                        <Button Content="Remove" MinWidth="58" Margin="4,0,0,0" Command="{Binding RemoveDoorFrameCommand}" />
                                        <Button Content="Up" MinWidth="36" Margin="8,0,0,0" Command="{Binding MoveDoorFrameUpCommand}" />
                                        <Button Content="Down" MinWidth="44" Margin="4,0,0,0" Command="{Binding MoveDoorFrameDownCommand}" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding DoorFrames}"
                                             SelectedItem="{Binding SelectedDoorFrame}"
                                             MaxHeight="220"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#80808080" BorderThickness="1" Margin="3" Padding="3" Background="#fafafa">
                                                    <StackPanel Width="80">
                                                        <Image Source="{Binding Preview}" Width="74" Height="74"
                                                               Stretch="UniformToFill"
                                                               Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <TextBlock Text="{Binding Display}" FontSize="10" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Block structure"
                                  Margin="0,0,0,8"
                                  Padding="8">
                            <GroupBox.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type local:BlockTreeNodeViewModel}"
                                                          ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Preview}" Width="20" Height="20" Margin="0,0,6,0"
                                               VerticalAlignment="Center" Stretch="Uniform"
                                               Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </GroupBox.Resources>
                            <TreeView ItemsSource="{Binding StructureTree}"
                                      MaxHeight="220" />
                        </GroupBox>
                        <GroupBox Header="Block animations"
                                  Margin="0,0,0,8"
                                  Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding AnimationSummary}"
                                           Foreground="#555"
                                           Margin="0,0,0,4" />
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding Animations}"
                                         SelectedItem="{Binding SelectedAnimation}"
                                         DisplayMemberPath="Display"
                                         MaxHeight="100" />
                                <StackPanel Grid.Row="2"
                                            Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,6">
                                        <Button Content="Add animation"
                                                Command="{Binding AddAnimationCommand}"
                                                Margin="0,0,6,0" />
                                        <Button Content="Remove animation"
                                                Command="{Binding RemoveAnimationCommand}" />
                                    </StackPanel>
                                    <Grid DataContext="{Binding SelectedAnimation}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Name" />
                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="1" Text="Target" />
                                        <ComboBox Grid.Row="1" Grid.Column="1"
                                                  ItemsSource="{Binding DataContext.SelectedBlock.AnimationTargets, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding Target, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="2" Text="Wall / face" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                            <TextBox Width="54"
                                                     Margin="0,0,6,0"
                                                     Text="{Binding WallIndexText, UpdateSourceTrigger=PropertyChanged}" />
                                            <ComboBox Width="110"
                                                      ItemsSource="{Binding DataContext.SelectedBlock.AnimationFaces, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Face, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="3" Text="Frame ms" />
                                        <TextBox Grid.Row="3" Grid.Column="1"
                                                 Width="72"
                                                 HorizontalAlignment="Left"
                                                 Text="{Binding FrameDurationMs, UpdateSourceTrigger=PropertyChanged}" />
                                        <CheckBox Grid.Row="4" Grid.Column="1"
                                                  Content="Loop"
                                                  IsChecked="{Binding Loop}" />
                                        <TextBlock Grid.Row="5" Text="Frames" />
                                        <TextBox Grid.Row="5" Grid.Column="1"
                                                 MinHeight="54"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Text="{Binding FramesText, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Add span"
                                    Command="{Binding AddWallSpanCommand}"
                                    Margin="0,0,6,0" />
                            <Button Content="Remove span"
                                    Command="{Binding RemoveWallSpanCommand}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Walls}"
                                 SelectedItem="{Binding SelectedWallSpan}"
                                 MaxHeight="220"
                                 Margin="0,6,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding DataContext.WallKinds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="1" Margin="4,0,0,0"
                                                 Text="{Binding Bottom, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2" Margin="4,0,0,0"
                                                 Text="{Binding Top, UpdateSourceTrigger=PropertyChanged}" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0,0,0">
                                            <TextBox Width="52"
                                                     Text="{Binding Texture, UpdateSourceTrigger=PropertyChanged}" />
                                            <CheckBox Margin="6,0,0,0" VerticalAlignment="Center"
                                                      IsChecked="{Binding Passable}"
                                                      Content="Passable" />
                                        </StackPanel>
                                        <UniformGrid Grid.Row="1"
                                                     Grid.ColumnSpan="4"
                                                     Columns="4"
                                                     Margin="0,4,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                                <TextBlock Text="N" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                <TextBox Width="46" Text="{Binding NorthTexture, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                                <TextBlock Text="E" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                <TextBox Width="46" Text="{Binding EastTexture, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                                <TextBlock Text="S" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                <TextBox Width="46" Text="{Binding SouthTexture, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="W" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                <TextBox Width="46" Text="{Binding WestTexture, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
                </TabItem>

                <TabItem Header="Validation">
                <Border Background="White" BorderBrush="#d0d0d0" BorderThickness="1" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="15" Text="Validation" Margin="0,0,0,10" />
                        <ListBox ItemsSource="{Binding ValidationMessages}" />
                    </DockPanel>
                </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
