                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding SelectedCellBlockSummary}" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                               FontSize="10"
                                               Foreground="#667085"
                                               Text="{Binding SelectedCellInstanceSummary}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,8" />
                                    <TextBlock Grid.Row="3" Text="Lower wall" />
                                    <ComboBox Grid.Row="3" Grid.Column="1"
                                              ItemsSource="{Binding TextureChoices}"
                                              SelectedValuePath="Key"
                                              SelectedValue="{Binding SelectedCellLowerWallTextureKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding Preview}" Width="24" Height="24" Stretch="UniformToFill" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Label}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="4" Text="Upper wall" />
