                                              ItemsSource="{Binding TextureChoices}"
                                              ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                              SelectedValuePath="Key"
                                              SelectedValue="{Binding SelectedCellUpperWallTextureKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="5" Text="Transparent" />
                                    <ComboBox Grid.Row="5" Grid.Column="1"
                                              ItemsSource="{Binding TextureChoices}"
                                              ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                              SelectedValuePath="Key"
                                              SelectedValue="{Binding SelectedCellTransparentWallTextureKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="6" Text="Floor" />
                                    <ComboBox Grid.Row="6" Grid.Column="1"
                                              ItemsSource="{Binding TextureChoices}"
                                              ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                              SelectedValuePath="Key"
                                              SelectedValue="{Binding SelectedCellFloorTextureKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="7" Text="Ceiling" />
                                    <ComboBox Grid.Row="7" Grid.Column="1"
                                              ItemsSource="{Binding TextureChoices}"
                                              ItemTemplate="{StaticResource TextureChoiceTemplate}"
                                              SelectedValuePath="Key"
                                              SelectedValue="{Binding SelectedCellCeilingTextureKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
