<Window x:Class="NuRcade.Editor.TextureImportProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add textures"
        Width="560" Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        MinWidth="420" MinHeight="320">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="StatusText"
                   Margin="0,0,0,6"
                   Text="Preparing…" />

        <ProgressBar Grid.Row="1"
                     x:Name="ImportProgress"
                     Height="18"
                     Minimum="0" />

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,4"
                   FontWeight="SemiBold"
                   Text="Results" />

        <Border Grid.Row="3"
                BorderBrush="#c4ccd6"
                BorderThickness="1"
                CornerRadius="3">
            <ListBox x:Name="ResultsList"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       FontWeight="SemiBold"
                                       Text="{Binding StatusText}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" />
                                <TextBlock FontSize="10"
                                           Foreground="#667085"
                                           TextWrapping="Wrap"
                                           Text="{Binding Detail}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="4"
                Margin="0,10,0,0"
                Background="#eef3ec"
                BorderBrush="#cfdcc8"
                BorderThickness="1"
                CornerRadius="3"
                Padding="8,6">
            <TextBlock x:Name="SummaryText"
                       Foreground="#3c5a32"
                       TextWrapping="Wrap"
                       Text="Working…" />
        </Border>

        <Button Grid.Row="5"
                x:Name="OkButton"
                Margin="0,12,0,0"
                Padding="20,4"
                HorizontalAlignment="Right"
                Content="OK"
                IsDefault="True"
                IsEnabled="False"
                Click="Ok_Click" />
    </Grid>
</Window>
